    <div class="rules-grid">

      <!-- SHADOWS -->
      <div class="rule-card">
        <div class="rule-topic">Shadows</div>
        <div class="rule-do">
          <span class="rule-badge do-badge">✓ Do</span>
          <div class="rule-example">
            <div style="width:80px;height:44px;background:#fff;border-radius:8px;box-shadow:0 4px 16px rgba(60,45,20,.10),0 2px 6px rgba(60,45,20,.06);display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:9px;color:var(--color-text-4);">warm-tinted</div>
          </div>
          <code>rgba(60, 45, 20, …)</code>
        </div>
        <div class="rule-dont">
          <span class="rule-badge dont-badge">✗ Don't</span>
          <div class="rule-example">
            <div style="width:80px;height:44px;background:#fff;border-radius:8px;box-shadow:0 4px 16px rgba(0,0,0,.10),0 2px 6px rgba(0,0,0,.06);display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:9px;color:var(--color-text-4);">cool gray</div>
          </div>
          <code>rgba(0, 0, 0, …)</code>
        </div>
        <p class="rule-why">Cool shadows look out-of-place on a warm palette — they make cards feel detached from the page background.</p>
      </div>

      <!-- HERO EYEBROW -->
      <div class="rule-card">
        <div class="rule-topic">Hero Eyebrow Badge</div>
        <div class="rule-do">
          <span class="rule-badge do-badge">✓ Do</span>
          <div class="rule-example">
            <div style="position:relative;overflow:hidden;height:26px;padding:0 14px;border-radius:9999px;border:1.5px solid rgba(180,130,0,.45);background:linear-gradient(135deg,#F5E27A 0%,#C9A000 55%,#F5E27A 100%);display:inline-flex;align-items:center;font-family:var(--font-mono);font-size:9px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#4A2E00;">GOLD on hero</div>
          </div>
          <span class="rule-text">Gold plate pill on home hero</span>
        </div>
        <div class="rule-dont">
          <span class="rule-badge dont-badge">✗ Don't</span>
          <div class="rule-example">
            <span style="display:inline-flex;align-items:center;padding:3px 10px;border-radius:9999px;background:rgba(28,112,247,.10);color:#1C70F7;border:1.5px solid rgba(28,112,247,.28);font-family:var(--font-mono);font-size:9px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;">BLUE on hero</span>
          </div>
          <span class="rule-text">Blue badge on home hero</span>
        </div>
        <p class="rule-why">Gold = award/No.1 status on hero. Blue badge is for inner product pages (InnerHero) only.</p>
      </div>

      <!-- NEUTRAL COLORS -->
      <div class="rule-card">
        <div class="rule-topic">Neutral Colors</div>
        <div class="rule-do">
          <span class="rule-badge do-badge">✓ Do</span>
          <div class="rule-example" style="display:flex;gap:4px;">
            {['#F5F3EE','#EEEAE2','#E8E4DA'].map(c=>(
              <div style={`width:28px;height:28px;border-radius:5px;background:${c};border:1px solid #D4CFC4;`}></div>
            ))}
          </div>
          <span class="rule-text">Warm undertone — beige, cream</span>
        </div>
        <div class="rule-dont">
          <span class="rule-badge dont-badge">✗ Don't</span>
          <div class="rule-example" style="display:flex;gap:4px;">
            {['#F5F5F5','#E5E5E5','#D4D4D4'].map(c=>(
              <div style={`width:28px;height:28px;border-radius:5px;background:${c};border:1px solid #ccc;`}></div>
            ))}
          </div>
          <span class="rule-text">#F0F0F0 or any cool gray</span>
        </div>
        <p class="rule-why">Cool grays clash with the warm page background and make the design feel like a generic SaaS template.</p>
      </div>

      <!-- GSAP ANIMATIONS -->
      <div class="rule-card">
        <div class="rule-topic">GSAP Animations</div>
        <div class="rule-do">
          <span class="rule-badge do-badge">✓ Do</span>
          <div class="rule-example">
            <code style="font-size:11px;background:var(--color-primary-50);color:var(--color-primary);padding:4px 8px;border-radius:6px;">gsap.fromTo(el, {'{'}opacity:0{'}'}, {'{'}opacity:1{'}'})</code>
          </div>
          <span class="rule-text">Always <code>fromTo()</code> — explicit start + end state</span>
        </div>
        <div class="rule-dont">
          <span class="rule-badge dont-badge">✗ Don't</span>
          <div class="rule-example">
            <code style="font-size:11px;background:#FEF2F2;color:#DC2626;padding:4px 8px;border-radius:6px;">gsap.from(el, {'{'}opacity:0{'}'})</code>
          </div>
          <span class="rule-text"><code>from()</code> — can leave elements invisible if trigger never fires</span>
        </div>
        <p class="rule-why"><code>from()</code> sets the start state immediately in JS. If ScrollTrigger never fires (e.g. element above fold, JS error), the element stays hidden. <code>fromTo()</code> keeps the DOM visible by default.</p>
      </div>

      <!-- STICKY IN GRID -->
      <div class="rule-card">
        <div class="rule-topic">Sticky Nav in CSS Grid</div>
        <div class="rule-do">
          <span class="rule-badge do-badge">✓ Do</span>
          <div class="rule-example">
            <code style="font-size:11px;background:var(--color-primary-50);color:var(--color-primary);padding:4px 8px;border-radius:6px;">ScrollTrigger.create({'{'} pin: '#whyNav' {'}'})</code>
          </div>
          <span class="rule-text">GSAP ScrollTrigger pin for WhyLivingOS nav</span>
        </div>
        <div class="rule-dont">
          <span class="rule-badge dont-badge">✗ Don't</span>
          <div class="rule-example">
            <code style="font-size:11px;background:#FEF2F2;color:#DC2626;padding:4px 8px;border-radius:6px;">position: sticky; top: 0;</code>
          </div>
          <span class="rule-text">CSS sticky inside CSS Grid <code>align-items: start</code></span>
        </div>
        <p class="rule-why">In a CSS Grid with <code>align-items: start</code>, a grid item's height equals its content — so sticky has no room to scroll. The element never actually sticks. Use GSAP instead.</p>
      </div>

      <!-- HERO BACKGROUND -->
      <div class="rule-card">
        <div class="rule-topic">Hero Background</div>
        <div class="rule-do">
          <span class="rule-badge do-badge">✓ Do</span>
          <div class="rule-example">
