---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Style Guide — LivingOS Design System">

<!-- ── Breakpoint ruler ── -->
<div class="bp-ruler">
  <span id="bpLabel">—</span>
  <span id="bpDesc" style="color:var(--color-text-4);margin-left:12px;"></span>
</div>

<div class="sg-wrap">

  <!-- INTRO -->
  <section class="sg-section">
    <div class="sg-eyebrow">LivingOS Design System</div>
    <h1 class="sg-title">Style Guide</h1>
    <p class="sg-intro">Single source of truth for colors, typography, spacing, components, and layout patterns used across the site. Resize the viewport to watch the breakpoint ruler change.</p>
  </section>

  <!-- ── Table of Contents ── -->
  <nav class="sg-toc" aria-label="Table of contents">
    <div class="toc-label">Contents</div>
    <ol class="toc-list">
      <li><a href="#sg-colors">1. Colors</a></li>
      <li><a href="#sg-typography">2. Typography</a></li>
      <li><a href="#sg-spacing">3. Spacing & Radius</a></li>
      <li><a href="#sg-buttons">4. Buttons</a></li>
      <li><a href="#sg-badges">5. Badges & Pills</a></li>
      <li><a href="#sg-backgrounds">6. Section Backgrounds</a></li>
      <li><a href="#sg-cards">7. Cards</a></li>
      <li><a href="#sg-layouts">8. Layout Patterns</a></li>
      <li><a href="#sg-faq-section">9. FAQ Accordion</a></li>
      <li><a href="#sg-breakpoints">10. Breakpoints</a></li>
      <li><a href="#sg-rules">11. Do / Don't</a></li>
    </ol>
  </nav>

  <!-- ════════════════════════════════
       1. COLORS
  ════════════════════════════════ -->
  <section class="sg-section" id="sg-colors">
    <h2 class="sg-h2">1. Colors</h2>

    <h3 class="sg-h3">Primary Blue</h3>
    <table class="comp-table">
      <thead><tr><th>Name</th><th>Example</th></tr></thead>
      <tbody>
        {[
          ['--color-primary','#1C70F7','light'],
          ['--color-primary-600','#1560D8','light'],
          ['--color-primary-400','#4D8EF9','light'],
          ['--color-primary-100','#DDEAFF','dark'],
          ['--color-primary-50','#EEF4FF','dark'],
        ].map(([name, hex, lbl]) => (
          <tr>
            <td><code>{name}</code><span class="hex-chip">{hex}</span></td>
            <td><div class="swatch" style={`background:${hex};${hex==='#EEF4FF'||hex==='#DDEAFF'?'border:1.5px solid #C8DAFF;':''}`}><span class={`sw-lbl ${lbl}`}>{hex}</span></div></td>
          </tr>
        ))}
      </tbody>
    </table>

    <h3 class="sg-h3">Warm Neutrals</h3>
    <table class="comp-table">
      <thead><tr><th>Name</th><th>Example</th></tr></thead>
      <tbody>
        {[
          ['--color-warm-page','#FFFFFF'],
          ['--color-warm-surface','#F5F3EE'],
          ['--color-warm-overlay','#EEEAE2'],
          ['--color-warm-border-light','#E8E4DA'],
          ['--color-warm-border-mid','#D4CFC4'],
        ].map(([name, hex]) => (
          <tr>
            <td><code>{name}</code><span class="hex-chip">{hex}</span></td>
            <td><div class="swatch" style={`background:${hex};border:1.5px solid #D4CFC4;`}><span class="sw-lbl dark">{hex}</span></div></td>
          </tr>
        ))}
      </tbody>
    </table>

    <h3 class="sg-h3">Orange Accent</h3>
    <table class="comp-table">
      <thead><tr><th>Name</th><th>Example</th></tr></thead>
      <tbody>
        {[
          ['--color-orange','#F97316','light'],
          ['--color-orange-100','#FFEDD5','dark'],
          ['--color-orange-50','#FFF7ED','dark'],
        ].map(([name, hex, lbl]) => (
          <tr>
            <td><code>{name}</code><span class="hex-chip">{hex}</span></td>
            <td><div class="swatch" style={`background:${hex};${lbl==='dark'?'border:1.5px solid #FDC090;':''}`}><span class={`sw-lbl ${lbl}`}>{hex}</span></div></td>
          </tr>
        ))}
      </tbody>
    </table>

    <h3 class="sg-h3">Text Scale</h3>
    <table class="comp-table">
      <thead><tr><th>Name</th><th>Example</th></tr></thead>
      <tbody>
        {[
          ['--color-text-1 · Heading','#1A1A1A'],
          ['--color-text-2 · Body','#3D3D3D'],
          ['--color-text-3 · Secondary','#6B6B6B'],
          ['--color-text-4 · Placeholder','#9A9A9A'],
          ['--color-text-5 · Disabled','#C4C4C4'],
        ].map(([name, hex]) => (
          <tr>
            <td><code>{name}</code><span class="hex-chip">{hex}</span></td>
            <td><div class="swatch swatch-text" style={`background:${hex};`}><span class="sw-lbl light">{hex}</span></div></td>
          </tr>
        ))}
      </tbody>
    </table>

    <h3 class="sg-h3">Semantic</h3>
    <table class="comp-table">
      <thead><tr><th>Name</th><th>Example</th></tr></thead>
      <tbody>
        <tr><td><code>success · icon / bg / border</code></td>
          <td style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
            <div class="swatch swatch-sm" style="background:#22C55E;"></div>
            <div class="swatch swatch-sm" style="background:#F0FDF4;border:1.5px solid #BBF7D0;"></div>
            <span style="font-size:12px;color:var(--color-text-3);">#22C55E · #F0FDF4 · #BBF7D0</span>
          </td>
        </tr>
        <tr><td><code>warning · icon / bg / border</code></td>
          <td style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
            <div class="swatch swatch-sm" style="background:#EAB308;"></div>
            <div class="swatch swatch-sm" style="background:#FEFCE8;border:1.5px solid #FEF08A;"></div>
            <span style="font-size:12px;color:var(--color-text-3);">#EAB308 · #FEFCE8 · #FEF08A</span>
          </td>
        </tr>
        <tr><td><code>error · icon / bg / border</code></td>
          <td style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
            <div class="swatch swatch-sm" style="background:#EF4444;"></div>
            <div class="swatch swatch-sm" style="background:#FEF2F2;border:1.5px solid #FCA5A5;"></div>
            <span style="font-size:12px;color:var(--color-text-3);">#EF4444 · #FEF2F2 · #FCA5A5</span>
          </td>
        </tr>
      </tbody>
    </table>

    <h3 class="sg-h3">Shadows</h3>
    <table class="comp-table">
      <thead><tr><th>Name</th><th>Example</th></tr></thead>
      <tbody>
        {[
          ['--shadow-sm','0 1px 4px rgba(60,45,20,.07), 0 1px 2px rgba(60,45,20,.05)'],
          ['--shadow-md','0 4px 16px rgba(60,45,20,.10), 0 2px 6px rgba(60,45,20,.06)'],
          ['--shadow-lg','0 12px 40px rgba(60,45,20,.13), 0 4px 12px rgba(60,45,20,.07)'],
          ['--shadow-blue','0 8px 24px rgba(28,112,247,.22), 0 2px 8px rgba(28,112,247,.14)'],
        ].map(([name, shadow]) => (
          <tr>
            <td><code>{name}</code></td>
            <td><div class="shadow-demo" style={`box-shadow:${shadow};`}>{name.replace('--shadow-','')}</div></td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <!-- ════════════════════════════════
       2. TYPOGRAPHY
  ════════════════════════════════ -->
  <section class="sg-section" id="sg-typography">
    <h2 class="sg-h2">2. Typography</h2>
    <p class="sg-note">Font: <strong>IBM Plex Sans Thai Looped</strong> (sans) · <strong>IBM Plex Mono</strong> (mono · currency, overlines, numbers)</p>

    <table class="comp-table type-table">
      <thead><tr><th>Token · Spec</th><th>Example</th></tr></thead>
      <tbody>
        <tr>
          <td><code>5xl</code><br/><span class="spec">60px · 700 · −0.025em · Hero / Display</span></td>
          <td><span style="font-size:clamp(32px,5vw,60px);font-weight:700;letter-spacing:-0.025em;line-height:1.1;color:var(--color-text-1);">บริหารได้ฉลาดกว่า</span></td>
        </tr>
        <tr>
          <td><code>4xl</code><br/><span class="spec">48px · 700 · −0.02em · Page title</span></td>
          <td><span style="font-size:clamp(26px,4vw,48px);font-weight:700;letter-spacing:-0.02em;line-height:1.1;color:var(--color-text-1);">Property Management</span></td>
        </tr>
        <tr>
          <td><code>3xl</code><br/><span class="spec">38px · 700 · −0.015em · Section h1</span></td>
          <td><span style="font-size:clamp(22px,3.2vw,38px);font-weight:700;letter-spacing:-0.015em;line-height:1.15;color:var(--color-text-1);">ระบบครบในที่เดียว</span></td>
        </tr>
        <tr>
          <td><code>2xl</code><br/><span class="spec">30px · 600 · −0.01em · Card title, h2</span></td>
          <td><span style="font-size:clamp(20px,2.5vw,30px);font-weight:600;letter-spacing:-0.01em;color:var(--color-text-1);">Home Service</span></td>
        </tr>
        <tr>
          <td><code>xl</code><br/><span class="spec">24px · 600 · 0 · h3, subsection</span></td>
          <td><span style="font-size:24px;font-weight:600;color:var(--color-text-1);">ฟีเจอร์หลัก</span></td>
        </tr>
        <tr>
          <td><code>lg</code><br/><span class="spec">20px · 500 · 0 · Lead text, h4</span></td>
          <td><span style="font-size:20px;font-weight:500;color:var(--color-text-1);">สั่งทำความสะอาดได้ทันที</span></td>
        </tr>
        <tr>
          <td><code>md</code><br/><span class="spec">17px · 300 · 0 · Body large</span></td>
          <td><span style="font-size:17px;font-weight:300;line-height:1.65;color:var(--color-text-3);">รองรับโครงการทุกขนาด ตั้งแต่คอนโดเล็กไปจนถึงโครงการขนาดใหญ่ ด้วยระบบที่ยืดหยุ่นและปรับแต่งได้</span></td>
        </tr>
        <tr>
          <td><code>base</code><br/><span class="spec">15px · 400 · 0 · Body default</span></td>
          <td><span style="font-size:15px;font-weight:400;line-height:1.65;color:var(--color-text-2);">นิติบุคคลสามารถจัดการข้อมูลลูกบ้าน บิลค่าใช้จ่าย และรายงานการเงินได้ในที่เดียว</span></td>
        </tr>
        <tr>
          <td><code>sm</code><br/><span class="spec">13px · 400 · 0 · Caption, helper</span></td>
          <td><span style="font-size:13px;font-weight:400;line-height:1.65;color:var(--color-text-3);">อัปเดตล่าสุด 4 มิ.ย. 2567 · ข้อมูลแสดงเป็น real-time</span></td>
        </tr>
        <tr>
          <td><code>xs · overline</code><br/><span class="spec">11px · 500–600 · +0.10em · MONO · UPPERCASE</span></td>
          <td><span style="font-family:var(--font-mono);font-size:11px;font-weight:600;letter-spacing:.10em;text-transform:uppercase;color:var(--color-text-4);">PROPERTY MANAGEMENT · SOLUTIONS</span></td>
        </tr>
        <tr>
          <td><code>mono · currency</code><br/><span class="spec">IBM Plex Mono · all numbers & prices</span></td>
          <td style="display:flex;align-items:baseline;gap:24px;flex-wrap:wrap;">
            <span style="font-family:var(--font-mono);font-size:28px;font-weight:700;color:var(--color-text-1);">฿ 2,450.00</span>
            <span style="font-family:var(--font-mono);font-size:22px;font-weight:700;color:var(--color-primary);">1,200+</span>
            <span style="font-family:var(--font-mono);font-size:18px;font-weight:600;color:var(--color-orange);">-25%</span>
          </td>
        </tr>
      </tbody>
    </table>
  </section>

  <!-- ════════════════════════════════
       3. SPACING & RADIUS
  ════════════════════════════════ -->
  <section class="sg-section" id="sg-spacing">
    <h2 class="sg-h2">3. Spacing & Border Radius</h2>

    <h3 class="sg-h3">Spacing — base unit 4px</h3>
    <table class="comp-table">
      <thead><tr><th>Name</th><th>Example</th></tr></thead>
      <tbody>
        {[
          ['sp-1','4px'],['sp-2','8px'],['sp-3','12px'],['sp-4','16px'],
          ['sp-6','24px'],['sp-8','32px'],['sp-10','40px'],['sp-12','48px'],
          ['sp-16','64px'],['sp-20','80px'],
        ].map(([token, size]) => (
          <tr>
            <td><code>{token}</code> <span class="spec">{size}</span></td>
            <td><div class="sp-box" style={`width:${size};height:${size};`}></div></td>
          </tr>
        ))}
      </tbody>
    </table>

    <h3 class="sg-h3">Border Radius</h3>
    <table class="comp-table">
      <thead><tr><th>Name</th><th>Example</th></tr></thead>
      <tbody>
        {[
          ['r-sm / --radius-sm','6px','form inputs'],
          ['r-md / --radius-md','10px','inputs, small buttons'],
          ['r-lg / --radius-lg','14px','cards default, alerts'],
          ['r-xl / --radius-xl','20px','large cards, modals'],
          ['r-2xl / --radius-2xl','28px','hero card, cover card'],
          ['r-full','9999px','pills, badges, chips'],
        ].map(([token, radius, usage]) => (
          <tr>
            <td><code>{token}</code> <span class="spec">{radius} · {usage}</span></td>
            <td><div class="radius-box" style={`border-radius:${radius};`}></div></td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <!-- ════════════════════════════════
       4. BUTTONS
  ════════════════════════════════ -->
  <section class="sg-section" id="sg-buttons">
    <h2 class="sg-h2">4. Buttons</h2>

    <table class="comp-table">
      <thead><tr><th>Name</th><th>Example</th></tr></thead>
      <tbody>
        <tr>
          <td>
            <code>cta-primary</code>
            <span class="spec">Hero / InnerHero primary action<br/>14px 28px · r-md · bg: --color-primary</span>
          </td>
          <td>
            <a href="#" class="btn-cta-primary">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3l14 9-14 9V3z"/></svg>
              เริ่มใช้งานฟรี 30 วัน
            </a>
          </td>
        </tr>
        <tr>
          <td>
            <code>cta-secondary</code>
            <span class="spec">Warm surface, beside primary<br/>14px 28px · r-md · bg: --color-warm-surface</span>
          </td>
          <td>
            <a href="#" class="btn-cta-secondary">ดูวิดีโอการทำงาน</a>
          </td>
        </tr>
        <tr>
          <td>
            <code>.btn-3d</code>
            <span class="spec">3D emboss style (cofounder.co technique)<br/>Works on any solid background color</span>
          </td>
          <td style="display:flex;gap:12px;flex-wrap:wrap;">
            <a href="#" class="btn-3d-eg btn-3d" style="background:var(--color-primary);">นัดสาธิตระบบ</a>
            <a href="#" class="btn-3d-eg btn-3d" style="background:var(--color-orange);">Living Mart</a>
          </td>
        </tr>
        <tr>
          <td>
            <code>card-cta · white pill</code>
            <span class="spec">On colored section bg (WhyLivingOS panels)<br/>r-full · bg: white · color: --color-text-1</span>
          </td>
          <td style="background:var(--color-primary);padding:16px;border-radius:12px;">
            <a href="#" class="btn-white-pill">
              ขอ Demo ฟรี
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </td>
        </tr>
        <tr>
          <td>
            <code>ih-cta-secondary</code>
            <span class="spec">Inner hero secondary — same as cta-secondary<br/>Used on solution/company inner pages</span>
          </td>
          <td>
            <a href="#" class="btn-cta-secondary">ดูราคาแผน →</a>
          </td>
        </tr>
      </tbody>
    </table>
  </section>

  <!-- ════════════════════════════════
       5. BADGES & PILLS
  ════════════════════════════════ -->
  <section class="sg-section" id="sg-badges">
    <h2 class="sg-h2">5. Badges & Pills</h2>
    <p class="sg-note">Rule: gold eyebrow on home hero <strong>only</strong>. Blue/orange badge on inner page InnerHero. Never blue badge on home hero.</p>

    <table class="comp-table">
      <thead><tr><th>Name</th><th>Example</th></tr></thead>
      <tbody>
        <tr>
          <td>
            <code>eyebrow-gold</code>
            <span class="spec">Home hero only · r-full · gold gradient<br/>shimmer sweep animation · font-mono 11px 600</span>
          </td>
          <td>
            <div style="position:relative;overflow:hidden;height:32px;padding:0 18px;border-radius:9999px;border:1.5px solid rgba(180,130,0,.45);background:linear-gradient(135deg,#F5E27A 0%,#E8C840 18%,#F0D060 35%,#C9A000 55%,#E8C840 72%,#F5E27A 88%,#D4A820 100%);box-shadow:0 1px 0 rgba(255,255,255,.55) inset,0 -1px 0 rgba(100,65,0,.18) inset,0 4px 16px rgba(180,130,0,.28);display:inline-flex;align-items:center;font-family:var(--font-mono);font-size:11px;font-weight:600;letter-spacing:.10em;text-transform:uppercase;width:fit-content;">
              <span style="color:#4A2E00;position:relative;z-index:1;text-shadow:0 1px 0 rgba(255,230,100,.6);">PMS · NO.1 IN THAILAND</span>
              <span style="position:absolute;inset:0;background:linear-gradient(105deg,transparent 30%,rgba(255,255,255,.55) 50%,transparent 70%);background-size:220% 100%;background-position:-100% 0;animation:gold-shimmer 3.5s ease-in-out infinite;border-radius:9999px;" aria-hidden="true"></span>
            </div>
          </td>
        </tr>
        <tr>
          <td>
            <code>ih-badge · blue</code>
            <span class="spec">Inner page InnerHero · r-full<br/>rgba(accent,.10) bg · rgba(accent,.28) border</span>
          </td>
          <td>
            <span style="display:inline-flex;align-items:center;padding:5px 14px;border-radius:9999px;background:rgba(28,112,247,.10);color:#1C70F7;border:1.5px solid rgba(28,112,247,.28);font-family:var(--font-mono);font-size:11px;font-weight:600;letter-spacing:.10em;text-transform:uppercase;">URBANICE APP</span>
          </td>
        </tr>
        <tr>
          <td>
            <code>ih-badge · orange</code>
            <span class="spec">Inner page accent (orange products)</span>
          </td>
          <td>
            <span style="display:inline-flex;align-items:center;padding:5px 14px;border-radius:9999px;background:rgba(249,115,22,.10);color:#F97316;border:1.5px solid rgba(249,115,22,.28);font-family:var(--font-mono);font-size:11px;font-weight:600;letter-spacing:.10em;text-transform:uppercase;">LIVING MART</span>
          </td>
        </tr>
        <tr>
          <td>
            <code>.overline</code>
            <span class="spec">Section label · font-mono 11px 500<br/>letter-spacing .10em · UPPERCASE · color-text-4</span>
          </td>
          <td>
            <span class="overline">SOLUTIONS · GUARD OS</span>
          </td>
        </tr>
        <tr>
          <td>
            <code>.trust-pill</code>
            <span class="spec">Hero CTA row · inline-flex + checkmark svg<br/>13px · color-text-3 · hidden on tablet/mobile</span>
          </td>
          <td>
            <span style="display:inline-flex;align-items:center;gap:6px;font-size:13px;color:var(--color-text-3);">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              ติดตั้งได้ภายใน 1 วัน
            </span>
          </td>
        </tr>
        <tr>
          <td>
            <code>.sov-badge</code>
            <span class="spec">SolutionOverview card footer · r-full<br/>font-mono 10.5px 600 · derived from section bgColor</span>
          </td>
          <td>
            <span style="display:inline-flex;align-items:center;padding:4px 10px;border-radius:9999px;background:rgba(28,112,247,.10);color:#1C70F7;border:1.5px solid rgba(28,112,247,.28);font-family:var(--font-mono);font-size:10.5px;font-weight:600;letter-spacing:.05em;">7+ ฟีเจอร์</span>
          </td>
        </tr>
        <tr>
          <td>
            <code>.g-badge · glass</code>
            <span class="spec">WhyLivingOS glass card header<br/>rgba white bg on colored panel bg</span>
          </td>
          <td style="background:#1C70F7;padding:12px;border-radius:10px;">
            <span style="font-size:10px;font-family:var(--font-mono);font-weight:600;padding:3px 8px;border-radius:5px;letter-spacing:.04em;background:rgba(255,255,255,.15);color:rgba(255,255,255,.85);border:1px solid rgba(255,255,255,.2);">Go-live Checklist</span>
          </td>
        </tr>
      </tbody>
    </table>
  </section>

  <!-- ════════════════════════════════
       6. SECTION BACKGROUNDS
  ════════════════════════════════ -->
  <section class="sg-section" id="sg-backgrounds">
    <h2 class="sg-h2">6. Section Backgrounds</h2>
    <p class="sg-note">Never alternate plain white → gray → white without an accent break. Every neutral must have warm undertone — no #F0F0F0 or cool gray.</p>

    <table class="comp-table">
      <thead><tr><th>Name</th><th>Example</th></tr></thead>
      <tbody>
        {[
          ['warm-page · #FFFFFF','Default page bg','#FFFFFF','1.5px solid #E8E4DA','',''],
          ['warm-surface · #F5F3EE','Alternate section bg','#F5F3EE','none','',''],
