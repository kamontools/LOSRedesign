---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Style Guide — LivingOS Design System">

<!-- ── Breakpoint ruler (sticky top) ── -->
<div class="bp-ruler">
  <span class="bp-label" id="bpLabel">—</span>
  <span class="bp-desc" id="bpDesc"></span>
</div>

<div class="sg-wrap">

  <!-- ══════════════════════════════════════════════
       0. INTRO
  ══════════════════════════════════════════════ -->
  <section class="sg-section">
    <div class="sg-eyebrow">LivingOS Design System</div>
    <h1 class="sg-title">Style Guide</h1>
    <p class="sg-intro">Single source of truth for colors, typography, spacing, components, and layout patterns used across the site. Resize the viewport to see breakpoints in the ruler above.</p>
  </section>

  <!-- ══════════════════════════════════════════════
       1. COLORS
  ══════════════════════════════════════════════ -->
  <section class="sg-section">
    <h2 class="sg-h2">1. Color Tokens</h2>

    <h3 class="sg-h3">Primary Blue</h3>
    <div class="swatch-row">
      <div class="swatch" style="background:#1C70F7;"><span class="swatch-label light">--color-primary<br/>#1C70F7</span></div>
      <div class="swatch" style="background:#1560D8;"><span class="swatch-label light">--color-primary-600<br/>#1560D8</span></div>
      <div class="swatch" style="background:#4D8EF9;"><span class="swatch-label light">--color-primary-400<br/>#4D8EF9</span></div>
      <div class="swatch" style="background:#DDEAFF;"><span class="swatch-label">--color-primary-100<br/>#DDEAFF</span></div>
      <div class="swatch" style="background:#EEF4FF;"><span class="swatch-label">--color-primary-50<br/>#EEF4FF</span></div>
    </div>

    <h3 class="sg-h3">Warm Neutrals</h3>
    <div class="swatch-row">
      <div class="swatch" style="background:#FFFFFF;border:1.5px solid #E8E4DA;"><span class="swatch-label">--color-warm-page<br/>#FFFFFF</span></div>
      <div class="swatch" style="background:#F5F3EE;"><span class="swatch-label">--color-warm-surface<br/>#F5F3EE</span></div>
      <div class="swatch" style="background:#EEEAE2;"><span class="swatch-label">--color-warm-overlay<br/>#EEEAE2</span></div>
      <div class="swatch" style="background:#E8E4DA;"><span class="swatch-label">--color-warm-border-light<br/>#E8E4DA</span></div>
      <div class="swatch" style="background:#D4CFC4;"><span class="swatch-label">--color-warm-border-mid<br/>#D4CFC4</span></div>
    </div>

    <h3 class="sg-h3">Orange Accent</h3>
    <div class="swatch-row">
      <div class="swatch" style="background:#F97316;"><span class="swatch-label light">--color-orange<br/>#F97316</span></div>
      <div class="swatch" style="background:#FFEDD5;"><span class="swatch-label">--color-orange-100<br/>#FFEDD5</span></div>
      <div class="swatch" style="background:#FFF7ED;"><span class="swatch-label">--color-orange-50<br/>#FFF7ED</span></div>
    </div>

    <h3 class="sg-h3">Text Scale</h3>
    <div class="swatch-row">
      <div class="swatch swatch-tall" style="background:#1A1A1A;"><span class="swatch-label light">--color-text-1<br/>#1A1A1A<br/>Heading</span></div>
      <div class="swatch swatch-tall" style="background:#3D3D3D;"><span class="swatch-label light">--color-text-2<br/>#3D3D3D<br/>Body</span></div>
      <div class="swatch swatch-tall" style="background:#6B6B6B;"><span class="swatch-label light">--color-text-3<br/>#6B6B6B<br/>Secondary</span></div>
      <div class="swatch swatch-tall" style="background:#9A9A9A;"><span class="swatch-label light">--color-text-4<br/>#9A9A9A<br/>Placeholder</span></div>
      <div class="swatch swatch-tall" style="background:#C4C4C4;"><span class="swatch-label">--color-text-5<br/>#C4C4C4<br/>Disabled</span></div>
    </div>

    <h3 class="sg-h3">Semantic</h3>
    <div class="swatch-row">
      <div class="swatch" style="background:#22C55E;"><span class="swatch-label light">success icon<br/>#22C55E</span></div>
      <div class="swatch" style="background:#F0FDF4;border:1.5px solid #BBF7D0;"><span class="swatch-label">success bg<br/>#F0FDF4</span></div>
      <div class="swatch" style="background:#EAB308;"><span class="swatch-label">warning icon<br/>#EAB308</span></div>
      <div class="swatch" style="background:#FEFCE8;border:1.5px solid #FEF08A;"><span class="swatch-label">warning bg<br/>#FEFCE8</span></div>
      <div class="swatch" style="background:#EF4444;"><span class="swatch-label light">error icon<br/>#EF4444</span></div>
      <div class="swatch" style="background:#FEF2F2;border:1.5px solid #FCA5A5;"><span class="swatch-label">error bg<br/>#FEF2F2</span></div>
    </div>

    <h3 class="sg-h3">Shadows</h3>
    <div class="shadow-row">
      <div class="shadow-demo" style="box-shadow:0 1px 4px rgba(60,45,20,.07),0 1px 2px rgba(60,45,20,.05);">shadow-sm</div>
      <div class="shadow-demo" style="box-shadow:0 4px 16px rgba(60,45,20,.10),0 2px 6px rgba(60,45,20,.06);">shadow-md</div>
      <div class="shadow-demo" style="box-shadow:0 12px 40px rgba(60,45,20,.13),0 4px 12px rgba(60,45,20,.07);">shadow-lg</div>
      <div class="shadow-demo" style="box-shadow:0 8px 24px rgba(28,112,247,.22),0 2px 8px rgba(28,112,247,.14);">shadow-blue</div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       2. TYPOGRAPHY
  ══════════════════════════════════════════════ -->
  <section class="sg-section">
    <h2 class="sg-h2">2. Typography Scale</h2>
    <p class="sg-note">Font: IBM Plex Sans Thai Looped (sans) · IBM Plex Mono (mono). All weights and sizes are defined as Tailwind v4 <code>@theme</code> tokens.</p>

    <div class="type-scale">
      <div class="type-row">
        <div class="type-meta"><span class="type-token">5xl</span><span class="type-spec">60px · 700 · −0.025em</span><span class="type-use">Hero / Display</span></div>
        <div class="type-sample" style="font-size:clamp(36px,5vw,60px);font-weight:700;letter-spacing:-0.025em;line-height:1.1;">บริหารได้ฉลาดกว่า</div>
      </div>
      <div class="type-row">
        <div class="type-meta"><span class="type-token">4xl</span><span class="type-spec">48px · 700 · −0.02em</span><span class="type-use">Page title</span></div>
        <div class="type-sample" style="font-size:clamp(28px,4vw,48px);font-weight:700;letter-spacing:-0.02em;line-height:1.1;">Property Management</div>
      </div>
      <div class="type-row">
        <div class="type-meta"><span class="type-token">3xl</span><span class="type-spec">38px · 700 · −0.015em</span><span class="type-use">Section h1</span></div>
        <div class="type-sample" style="font-size:clamp(24px,3.2vw,38px);font-weight:700;letter-spacing:-0.015em;line-height:1.15;">ระบบครบในที่เดียว</div>
      </div>
      <div class="type-row">
        <div class="type-meta"><span class="type-token">2xl</span><span class="type-spec">30px · 600 · −0.01em</span><span class="type-use">Card title, h2</span></div>
        <div class="type-sample" style="font-size:clamp(20px,2.5vw,30px);font-weight:600;letter-spacing:-0.01em;">Home Service</div>
      </div>
      <div class="type-row">
        <div class="type-meta"><span class="type-token">xl</span><span class="type-spec">24px · 600 · 0em</span><span class="type-use">h3, subsection</span></div>
        <div class="type-sample" style="font-size:24px;font-weight:600;">ฟีเจอร์หลัก</div>
      </div>
      <div class="type-row">
        <div class="type-meta"><span class="type-token">lg</span><span class="type-spec">20px · 500 · 0em</span><span class="type-use">Lead text, h4</span></div>
        <div class="type-sample" style="font-size:20px;font-weight:500;">สั่งทำความสะอาดได้ทันที</div>
      </div>
      <div class="type-row">
        <div class="type-meta"><span class="type-token">md</span><span class="type-spec">17px · 300 · 0em</span><span class="type-use">Body large</span></div>
        <div class="type-sample" style="font-size:17px;font-weight:300;line-height:1.65;">รองรับโครงการทุกขนาด ตั้งแต่คอนโดเล็กไปจนถึงโครงการขนาดใหญ่ ด้วยระบบที่ยืดหยุ่นและปรับแต่งได้</div>
      </div>
      <div class="type-row">
        <div class="type-meta"><span class="type-token">base</span><span class="type-spec">15px · 400 · 0em</span><span class="type-use">Body default</span></div>
        <div class="type-sample" style="font-size:15px;font-weight:400;line-height:1.65;">นิติบุคคลสามารถจัดการข้อมูลลูกบ้าน บิลค่าใช้จ่าย และรายงานการเงินได้ในที่เดียว</div>
      </div>
      <div class="type-row">
        <div class="type-meta"><span class="type-token">sm</span><span class="type-spec">13px · 400 · 0em</span><span class="type-use">Caption, helper</span></div>
        <div class="type-sample" style="font-size:13px;font-weight:400;color:var(--color-text-3);">อัปเดตล่าสุด 4 มิ.ย. 2567 · ข้อมูลแสดงเป็น real-time</div>
      </div>
      <div class="type-row">
        <div class="type-meta"><span class="type-token">xs / overline</span><span class="type-spec">11px · 500–600 · +0.10em · MONO · UPPERCASE</span><span class="type-use">Overline label</span></div>
        <div class="type-sample" style="font-family:var(--font-mono);font-size:11px;font-weight:600;letter-spacing:.10em;text-transform:uppercase;color:var(--color-text-4);">PROPERTY MANAGEMENT · SOLUTIONS</div>
      </div>
    </div>

    <h3 class="sg-h3">Mono — Currency & Numbers</h3>
    <div class="type-mono-demo">
      <span style="font-family:var(--font-mono);font-size:32px;font-weight:700;color:var(--color-text-1);">฿ 2,450.00</span>
      <span style="font-family:var(--font-mono);font-size:24px;font-weight:700;color:var(--color-primary);">1,200+</span>
      <span style="font-family:var(--font-mono);font-size:18px;font-weight:500;color:var(--color-orange);">-25%</span>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       3. SPACING & RADIUS
  ══════════════════════════════════════════════ -->
  <section class="sg-section">
    <h2 class="sg-h2">3. Spacing & Border Radius</h2>

    <h3 class="sg-h3">Spacing — base unit 4px</h3>
    <div class="spacing-row">
      {[
        ['sp-1','4px'],['sp-2','8px'],['sp-3','12px'],['sp-4','16px'],
        ['sp-6','24px'],['sp-8','32px'],['sp-10','40px'],['sp-12','48px'],
        ['sp-16','64px'],['sp-20','80px'],
      ].map(([token, size]) => (
        <div class="spacing-item">
          <div class="spacing-box" style={`width:${size};height:${size};`}></div>
          <span class="spacing-label">{token}</span>
          <span class="spacing-size">{size}</span>
        </div>
      ))}
    </div>

    <h3 class="sg-h3">Border Radius</h3>
    <div class="radius-row">
      {[
        ['r-sm','6px'],['r-md','10px'],['r-lg','14px'],['r-xl','20px'],
        ['r-2xl','28px'],['r-full','9999px'],
      ].map(([token, radius]) => (
        <div class="radius-item">
          <div class="radius-box" style={`border-radius:${radius};`}></div>
          <span class="spacing-label">{token}</span>
          <span class="spacing-size">{radius}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       4. BUTTONS
  ══════════════════════════════════════════════ -->
  <section class="sg-section">
    <h2 class="sg-h2">4. Buttons</h2>

    <h3 class="sg-h3">Primary CTA (Hero / Inner Hero)</h3>
    <div class="btn-row">
      <a href="#" class="cta-primary-demo">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3l14 9-14 9V3z"/></svg>
        เริ่มใช้งานฟรี 30 วัน
      </a>
      <code class="sg-code">padding: 14px 28px · r-md · bg: --color-primary · shadow: blue 35%</code>
    </div>

    <h3 class="sg-h3">Secondary CTA (Warm Surface)</h3>
    <div class="btn-row">
      <a href="#" class="cta-secondary-demo">ดูวิดีโอการทำงาน</a>
      <code class="sg-code">padding: 14px 28px · r-md · bg: --color-warm-surface · border: --color-warm-border-light</code>
    </div>

    <h3 class="sg-h3">3D Emboss Button (.btn-3d)</h3>
    <div class="btn-row">
      <a href="#" class="btn-3d-demo btn-3d">นัดสาธิตระบบ</a>
      <a href="#" class="btn-3d-demo btn-3d" style="background:var(--color-orange);">Living Mart</a>
      <code class="sg-code">.btn-3d — layered gradient + inset bevel shadows. Works on any solid bg color.</code>
    </div>

    <h3 class="sg-h3">White Pill CTA (on colored section bg)</h3>
    <div class="btn-row" style="background:#1C70F7;padding:24px;border-radius:14px;">
      <a href="#" class="pill-cta-demo">ดูรายละเอียด →</a>
      <code class="sg-code" style="color:rgba(255,255,255,.6);">bg: white · color: --color-text-1 · r-full · font-weight: 600</code>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       5. BADGES & PILLS
  ══════════════════════════════════════════════ -->
  <section class="sg-section">
    <h2 class="sg-h2">5. Badges & Pills</h2>

    <div class="badge-row">

      <!-- Gold eyebrow pill -->
      <div class="eyebrow-gold inline-flex items-center gap-2" style="position:relative;overflow:hidden;height:32px;padding:0 18px;border-radius:9999px;border:1.5px solid rgba(180,130,0,.45);background:linear-gradient(135deg,#F5E27A 0%,#E8C840 18%,#F0D060 35%,#C9A000 55%,#E8C840 72%,#F5E27A 88%,#D4A820 100%);box-shadow:0 1px 0 rgba(255,255,255,.55) inset,0 -1px 0 rgba(100,65,0,.18) inset,0 4px 16px rgba(180,130,0,.28);font-family:var(--font-mono);font-size:11px;font-weight:600;letter-spacing:.10em;text-transform:uppercase;cursor:default;">
        <span style="color:#4A2E00;position:relative;z-index:1;text-shadow:0 1px 0 rgba(255,230,100,.6);">PMS · NO.1 IN THAILAND</span>
        <span style="position:absolute;inset:0;background:linear-gradient(105deg,transparent 30%,rgba(255,255,255,.55) 50%,transparent 70%);background-size:220% 100%;background-position:-100% 0;animation:gold-shimmer 3.5s ease-in-out infinite;border-radius:9999px;" aria-hidden="true"></span>
      </div>

      <!-- Blue badge (inner page) -->
      <span style="display:inline-flex;align-items:center;padding:5px 14px;border-radius:9999px;background:rgba(28,112,247,.10);color:#1C70F7;border:1.5px solid rgba(28,112,247,.28);font-family:var(--font-mono);font-size:11px;font-weight:600;letter-spacing:.10em;text-transform:uppercase;">URBANICE APP</span>

      <!-- Orange badge -->
      <span style="display:inline-flex;align-items:center;padding:5px 14px;border-radius:9999px;background:rgba(249,115,22,.10);color:#F97316;border:1.5px solid rgba(249,115,22,.28);font-family:var(--font-mono);font-size:11px;font-weight:600;letter-spacing:.10em;text-transform:uppercase;">LIVING MART</span>

      <!-- Overline label -->
      <span class="overline">SOLUTIONS · GUARD OS</span>

      <!-- Trust pill -->
      <span style="display:inline-flex;align-items:center;gap:6px;font-size:13px;color:var(--color-text-3);">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        ติดตั้งได้ภายใน 1 วัน
      </span>

      <!-- Card sov-badge -->
      <span style="display:inline-flex;align-items:center;padding:4px 10px;border-radius:9999px;background:rgba(28,112,247,.10);color:#1C70F7;border:1.5px solid rgba(28,112,247,.28);font-family:var(--font-mono);font-size:10.5px;font-weight:600;letter-spacing:.05em;">7+ ฟีเจอร์</span>

    </div>
    <p class="sg-note" style="margin-top:16px;">Rule: gold eyebrow on hero only. Blue/orange badge on inner page InnerHero. Never blue badge on home hero.</p>
  </section>

  <!-- ══════════════════════════════════════════════
       6. CARDS
  ══════════════════════════════════════════════ -->
  <section class="sg-section">
    <h2 class="sg-h2">6. Cards</h2>

    <h3 class="sg-h3">Stats Row (.stats-row + .stat-cell)</h3>
    <div class="stats-row">
      <div class="stat-cell">
        <div class="stat-num">1,200+</div>
        <div class="stat-lbl">โครงการที่ใช้งาน</div>
      </div>
      <div class="stat-cell">
        <div class="stat-num">98%</div>
        <div class="stat-lbl">ความพึงพอใจลูกค้า</div>
      </div>
      <div class="stat-cell">
        <div class="stat-num">฿ 2.4B</div>
        <div class="stat-lbl">มูลค่าธุรกรรมต่อปี</div>
      </div>
      <div class="stat-cell">
        <div class="stat-num">24/7</div>
        <div class="stat-lbl">Support</div>
      </div>
    </div>

    <h3 class="sg-h3" style="margin-top:40px;">SolutionOverview Card (.sov-card)</h3>
    <p class="sg-note">Tilted paper-clip cards on a colored background. Hover to straighten.</p>
    <div style="background:#1C70F7;border-radius:20px;padding:40px 32px 48px;">
      <div class="sov-grid-demo">
        {[
          { title: 'แดชบอร์ดนิติบุคคล', desc: 'ดูภาพรวมอาคาร รายรับ-รายจ่าย และสถานะห้องพักแบบ real-time', badge: 'CORE MODULE', emoji: '🏢', rot: '-5deg' },
          { title: 'ระบบบิลอัตโนมัติ', desc: 'ออกบิลค่าส่วนกลาง ค่าน้ำ ค่าไฟ ส่งให้ลูกบ้านอัตโนมัติทุกเดือน', badge: '99.9% UPTIME', emoji: '📄', rot: '3.5deg' },
          { title: 'รายงานการเงิน', desc: 'Export งบกำไรขาดทุน บัญชีแยกประเภท และสรุปค้างชำระ', badge: 'EXPORT PDF', emoji: '📊', rot: '-3deg' },
          { title: 'แจ้งซ่อมออนไลน์', desc: 'ลูกบ้านแจ้งซ่อมผ่านแอป ทีมช่างรับงาน ติดตามสถานะได้ทุกขั้นตอน', badge: 'REAL-TIME', emoji: '🔧', rot: '5deg' },
        ].map((c) => (
          <div class="sov-card-outer-demo">
            <div class="sov-card-inner-demo" style={`--rot:${c.rot};`}>
              <div class="sov-clip-demo" aria-hidden="true">
                <svg width="22" height="50" viewBox="0 0 22 50" fill="none"><rect x="8" y="0" width="6" height="50" rx="3" fill="#C8C0B0"/><rect x="10" y="4" width="2" height="42" rx="1" fill="#E8E0D0"/></svg>
              </div>
              <div class="sov-card-demo">
                <h3 style="font-size:16px;font-weight:700;color:var(--color-text-1);margin-bottom:8px;">{c.title}</h3>
                <p style="font-size:13.5px;color:var(--color-text-3);line-height:1.6;flex:1;">{c.desc}</p>
                <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-top:16px;">
                  <span style="padding:4px 10px;border-radius:9999px;background:rgba(28,112,247,.10);color:#1C70F7;border:1.5px solid rgba(28,112,247,.28);font-family:var(--font-mono);font-size:10.5px;font-weight:600;">{c.badge}</span>
                  <span style="font-size:38px;line-height:1;filter:drop-shadow(0 4px 10px rgba(0,0,0,.14));">{c.emoji}</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <h3 class="sg-h3" style="margin-top:40px;">Two-Cards Grid (.two-cards-grid / .service-card)</h3>
    <p class="sg-note">Used on Urbanice page for Home Service + Living Mart.</p>
    <div class="two-cards-demo-grid">
      <!-- Card 1 -->
      <div class="service-card-demo">
        <div style="background:#fff;padding:28px 28px 22px;flex-shrink:0;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:10px;">
            <h2 style="font-size:28px;font-weight:700;line-height:1.15;color:#1A1A1A;margin:0;flex:1;">Home Service</h2>
            <div style="width:22px;height:22px;border-radius:50%;background:radial-gradient(circle at 38% 35%,#FF6B6B,#C0000C);box-shadow:inset 2px 2px 3px rgba(255,180,180,.65),inset -1.5px -1.5px 3px rgba(80,0,0,.45),0 3px 8px rgba(180,0,20,.35);flex-shrink:0;"></div>
          </div>
          <p style="font-size:14px;color:#6B6B6B;line-height:1.65;">สั่งทำความสะอาด ซักรีด ล้างแอร์ และอีกมากมาย ได้ทันทีในแอป</p>
        </div>
        <div style="flex:1;background:linear-gradient(180deg,#B2E8EA 0%,#7ACFD3 100%);display:flex;align-items:center;justify-content:center;padding:24px;min-height:200px;">
          <div style="display:flex;flex-direction:column;gap:8px;width:100%;max-width:240px;">
