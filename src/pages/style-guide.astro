        </div>
        <div class="rule-dont">
          <span class="rule-badge dont-badge">✗ Don't</span>
          <div class="rule-example" style="display:flex;flex-direction:column;gap:3px;width:100%;">
            {[['#FFFFFF','white','1px solid #E8E4DA'],['#F5F5F5','light gray','none'],['#FFFFFF','white','1px solid #E8E4DA'],['#F5F5F5','light gray','none']].map(([bg,label,border])=>(
