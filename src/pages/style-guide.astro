<!-- ── FAQ script ── -->
<script>
  const faq = document.getElementById('sg-faq');
  if (faq) {
    faq.querySelectorAll('.faq-trigger').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const item = trigger.closest('.faq-item');
        const answer = item?.querySelector('.faq-answer') as HTMLElement | null;
        const icon = trigger.querySelector('.faq-icon') as HTMLElement | null;
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';
        faq.querySelectorAll('.faq-trigger').forEach((t) => {
          if (t !== trigger) {
            const a = t.closest('.faq-item')?.querySelector('.faq-answer') as HTMLElement | null;
            const ic = t.querySelector('.faq-icon') as HTMLElement | null;
            t.setAttribute('aria-expanded', 'false');
            if (a) a.style.height = '0';
            if (ic) ic.style.transform = 'rotate(0deg)';
          }
        });
        if (isOpen) {
          trigger.setAttribute('aria-expanded', 'false');
          if (answer) answer.style.height = '0';
          if (icon) icon.style.transform = 'rotate(0deg)';
        } else {
          trigger.setAttribute('aria-expanded', 'true');
          if (answer) answer.style.height = answer.scrollHeight + 'px';
          if (icon) icon.style.transform = 'rotate(180deg)';
        }
      });
    });
  }
</script>

<!-- ── Breakpoint ruler ── -->
<script>
  function updateBp() {
    const w = window.innerWidth;
    const lbl = document.getElementById('bpLabel');
    const desc = document.getElementById('bpDesc');
    if (!lbl || !desc) return;
    if (w <= 475) {
      lbl.textContent = 'MOBILE ≤ 475px'; lbl.style.color = '#EF4444';
    } else if (w <= 1279) {
      lbl.textContent = 'TABLET 476–1279px'; lbl.style.color = '#F97316';
    } else {
      lbl.textContent = 'DESKTOP ≥ 1280px'; lbl.style.color = '#1C70F7';
    }
    desc.textContent = `${w}px`;
  }
  updateBp();
  window.addEventListener('resize', updateBp);
</script>

<!-- ── WhyLivingOS demo: sticky nav + IntersectionObserver ── -->
<script>
  (function () {
    const box = document.getElementById('whyDemoBox');
    const nav = document.getElementById('whyDemoNav');
    if (!box || !nav) return;

    const navItems = Array.from(nav.querySelectorAll<HTMLElement>('.wdn-item'));
    const anchors  = Array.from(box.querySelectorAll<HTMLElement>('[data-wdp]'));

    function setActive(idx: number) {
      navItems.forEach((n, i) => {
        n.classList.toggle('wdn-active', i === idx);
      });
    }

    // IntersectionObserver scoped to the scroll container
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setActive(Number((entry.target as HTMLElement).dataset.wdp));
          }
        });
      },
      { root: box, threshold: 0.45 }
    );

    anchors.forEach((a) => observer.observe(a));

    // Click nav → scroll panel into view within the container
    navItems.forEach((item, i) => {
      item.addEventListener('click', () => {
        anchors[i]?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    });
  })();
</script>

