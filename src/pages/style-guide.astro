              <div style="position:absolute;inset:0;background:linear-gradient(to right,rgba(255,255,255,.85),rgba(255,255,255,.3));"></div>
              <span style="position:relative;z-index:1;">photo + gradient mask</span>
            </div>
          </div>
          <span class="rule-text">Real photography with gradient overlay</span>
        </div>
        <div class="rule-dont">
          <span class="rule-badge dont-badge">✗ Don't</span>
          <div class="rule-example">
            <div style="width:100%;height:40px;border-radius:8px;background:radial-gradient(ellipse at 30% 50%, rgba(100,200,255,.4) 0%, transparent 60%), radial-gradient(ellipse at 70% 50%, rgba(200,150,255,.3) 0%, transparent 60%), #0a0a1a;display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:9px;color:rgba(255,255,255,.6);">abstract blobs / dark canvas</div>
          </div>
          <span class="rule-text">Abstract blobs, noise, or dark <code>#0A0A0F</code> canvas</span>
        </div>
        <p class="rule-why">LivingOS targets building managers, not developers. Techy dark backgrounds signal the wrong brand personality — warm + contextual photography builds trust faster.</p>
      </div>

      <!-- TYPOGRAPHY -->
      <div class="rule-card">
        <div class="rule-topic">Typography & Fonts</div>
        <div class="rule-do">
          <span class="rule-badge do-badge">✓ Do</span>
          <div class="rule-example" style="display:flex;align-items:baseline;gap:12px;">
            <span style="font-family:'IBM Plex Sans Thai Looped',sans-serif;font-size:14px;font-weight:600;color:var(--color-text-1);">IBM Plex Sans</span>
            <span style="font-family:'IBM Plex Mono',monospace;font-size:13px;font-weight:500;color:var(--color-primary);">฿ 2,450</span>
          </div>
          <span class="rule-text">IBM Plex Sans Thai Looped (UI) + Mono (numbers)</span>
        </div>
        <div class="rule-dont">
          <span class="rule-badge dont-badge">✗ Don't</span>
          <div class="rule-example" style="display:flex;align-items:baseline;gap:12px;opacity:.5;">
            <span style="font-family:sans-serif;font-size:14px;font-weight:600;color:var(--color-text-1);">Inter / Roboto</span>
            <span style="font-family:sans-serif;font-size:14px;font-weight:600;color:#0d6efd;">Bootstrap #0d6efd</span>
          </div>
          <span class="rule-text">Inter, Roboto, Sarabun, Bootstrap palette</span>
        </div>
        <p class="rule-why">Sarabun is common in Thai gov/corporate sites — it signals "old". IBM Plex was chosen for its modern Thai character support and clean numerics for financial data.</p>
      </div>

      <!-- SECTION RHYTHM -->
      <div class="rule-card">
        <div class="rule-topic">Section Rhythm</div>
        <div class="rule-do">
          <span class="rule-badge do-badge">✓ Do</span>
          <div class="rule-example" style="display:flex;flex-direction:column;gap:3px;width:100%;">
            {[['#FFFFFF','white','1px solid #E8E4DA'],['#1C70F7','blue accent','none'],['#F5F3EE','warm surface','none'],['#F97316','orange accent','none'],['#FFFFFF','white','1px solid #E8E4DA']].map(([bg,label,border])=>(
