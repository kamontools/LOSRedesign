---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="เข้าสู่ระบบ — The LivingOS"
  description="เข้าสู่ระบบ The LivingOS PMS, GuardOS และแพลตฟอร์มอื่นๆ"
>
  <div class="login-page">

    <!-- Left: Branding panel -->
    <div class="login-brand">
      <div class="brand-content">
        <a href="/" class="brand-logo">
          <img src="/logo-livingos.svg" alt="The LivingOS" width="40" height="40" style="border-radius:12px;" />
          <span>The LivingOS</span>
        </a>
        <div class="brand-copy">
          <h2>จัดการโครงการ<br /><span>ได้ทุกที่ทุกเวลา</span></h2>
          <p>เข้าสู่ระบบเพื่อจัดการบัญชี ลูกบ้าน และรายงานของโครงการคุณ</p>
        </div>
        <div class="brand-trust">
          {['1,000+ โครงการ','200K+ ลูกบ้าน','99.9% Uptime'].map((t) => (
            <span>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.8)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              {t}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- Right: Login form -->
    <div class="login-form-side">
      <div class="login-form-wrap">

        <!-- Mobile logo -->
        <a href="/" class="mobile-logo">
          <img src="/logo-livingos.svg" alt="The LivingOS" width="32" height="32" style="border-radius:9px;" />
          <span>The LivingOS</span>
        </a>

        <h1 class="login-title">เข้าสู่ระบบ</h1>
        <p class="login-sub">ยินดีต้อนรับกลับ</p>

        <form class="login-form" novalidate>
          <div class="form-group">
            <label for="email">อีเมลหรือชื่อผู้ใช้</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="your@company.com"
              autocomplete="email"
              required
              class="login-input"
            />
          </div>
          <div class="form-group">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
              <label for="password" style="margin-bottom:0;">รหัสผ่าน</label>
              <a href="#" class="forgot-link">ลืมรหัสผ่าน?</a>
            </div>
            <div class="password-wrap">
              <input
                type="password"
                id="password"
                name="password"
                placeholder="••••••••"
                autocomplete="current-password"
                required
                class="login-input"
              />
              <button type="button" class="pw-toggle" aria-label="แสดง/ซ่อนรหัสผ่าน">
                <svg id="pw-eye" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>

          <div style="display:flex;align-items:center;gap:10px;">
            <input type="checkbox" id="remember" name="remember" style="width:16px;height:16px;accent-color:var(--color-primary);" />
            <label for="remember" style="font-size:13px;color:var(--color-text-3);cursor:pointer;">จดจำการเข้าสู่ระบบ</label>
          </div>

          <button type="submit" class="login-submit">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
            เข้าสู่ระบบ
          </button>
        </form>

        <!-- SSO / Alternative -->
        <div class="login-divider"><span>หรือ</span></div>

        <button class="sso-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2H3a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h18a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2z"/><path d="M12 12m-3 0a3 3 0 1 0 6 0a3 3 0 1 0-6 0"/></svg>
          เข้าสู่ระบบด้วย SSO / SAML
        </button>

        <p class="login-footer">
          ยังไม่มีบัญชี? <a href="/request-demo">ขอ Demo ฟรี</a>
        </p>
      </div>
    </div>

  </div>
</BaseLayout>

<script>
  const toggle = document.querySelector('.pw-toggle');
  const pwInput = document.getElementById('password') as HTMLInputElement;
  if (toggle && pwInput) {
    toggle.addEventListener('click', () => {
      pwInput.type = pwInput.type === 'password' ? 'text' : 'password';
    });
  }
</script>

<style>
  /* Hide the default BaseLayout navbar spacer — login is full-screen */
  .login-page {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100vh;
    /* Override the navbar spacer */
  }

  /* Left branding panel */
  .login-brand {
    background: linear-gradient(145deg, #1C70F7 0%, #1048A8 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px;
    position: relative;
    overflow: hidden;
  }

  .login-brand::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,.08) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  .brand-content {
    position: relative;
    z-index: 1;
    max-width: 380px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #fff;
    font-weight: 700;
    font-size: 18px;
  }

  .brand-copy h2 {
    font-size: clamp(28px, 3vw, 38px);
    font-weight: 700;
    color: #fff;
    line-height: 1.15;
    margin-bottom: 12px;
  }

  .brand-copy h2 span { color: rgba(255,237,213,1); }

  .brand-copy p {
    font-size: 16px;
    color: rgba(255,255,255,.75);
    line-height: 1.6;
  }

  .brand-trust {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .brand-trust span {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: rgba(255,255,255,.75);
  }

  /* Right login form */
  .login-form-side {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 32px;
    background: var(--color-warm-page);
  }

  .login-form-wrap {
    width: 100%;
    max-width: 400px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .mobile-logo {
    display: none;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--color-text-1);
    font-weight: 700;
    font-size: 16px;
    margin-bottom: 8px;
  }

  .login-title {
    font-size: 28px;
    font-weight: 700;
    color: var(--color-text-1);
    margin-bottom: 4px;
  }

  .login-sub {
    font-size: 15px;
    color: var(--color-text-3);
    margin-top: -12px;
  }

  .login-form { display: flex; flex-direction: column; gap: 16px; }

  .form-group { display: flex; flex-direction: column; gap: 6px; }

  .form-group label {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-2);
  }

  .login-input {
    border: 1.5px solid var(--color-warm-border-mid);
    border-radius: 10px;
    background: #fff;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-text-1);
    padding: 11px 14px;
    outline: none;
    width: 100%;
    transition: border-color .15s, box-shadow .15s;
  }

  .login-input:focus {
    border-color: var(--color-primary-400);
    box-shadow: 0 0 0 3px rgba(28,112,247,.12);
  }

  .password-wrap { position: relative; }
  .password-wrap .login-input { padding-right: 44px; }

  .pw-toggle {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text-4);
    padding: 4px;
  }
  .pw-toggle:hover { color: var(--color-text-2); }

  .forgot-link {
    font-size: 12px;
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
  }

  .login-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px;
    border-radius: 12px;
    background: var(--color-primary);
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 18px rgba(28,112,247,.38);
    transition: transform .15s, filter .15s;
    margin-top: 4px;
  }
  .login-submit:hover { transform: translateY(-1px); filter: brightness(1.08); }

  .login-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--color-text-5);
    font-size: 12px;
  }
  .login-divider::before,
  .login-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-warm-border-light);
  }

  .sso-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
    border-radius: 10px;
    background: #fff;
    color: var(--color-text-2);
    font-size: 14px;
    font-weight: 500;
    border: 1.5px solid var(--color-warm-border-light);
    cursor: pointer;
    transition: background .15s, border-color .15s;
    width: 100%;
  }
  .sso-btn:hover { background: var(--color-warm-surface); border-color: var(--color-warm-border-mid); }

  .login-footer {
    text-align: center;
    font-size: 13px;
    color: var(--color-text-3);
  }
  .login-footer a { color: var(--color-primary); font-weight: 600; text-decoration: none; }

  @media (max-width: 768px) {
    .login-page { grid-template-columns: 1fr; }
    .login-brand { display: none; }
    .mobile-logo { display: flex; }
    .login-form-side { padding: 32px 24px; min-height: 100vh; align-items: flex-start; padding-top: 48px; }
  }
</style>
