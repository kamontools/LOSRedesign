---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerHero from '../../components/shared/InnerHero.astro';
import InnerFAQ from '../../components/shared/InnerFAQ.astro';
import CTABanner from '../../components/home/CTABanner.astro';
import SolutionOverview from '../../components/shared/SolutionOverview.astro';

const ACCENT = '#13A8AE';
const ACCENT_LIGHT = '#E0F7F8';

const faqs = [
  { q: 'Living Mart คืออะไร?', a: 'Living Mart เป็นบริการ Home Service Marketplace ที่เชื่อมลูกบ้านกับผู้ให้บริการในโครงการ เช่น ทำความสะอาด ซักรีด ดูแลต้นไม้ ผ่านแอป Urbanice' },
  { q: 'นิติบุคคลสามารถเพิ่ม Vendor ของตัวเองได้ไหม?', a: 'ได้ นิติบุคคลสามารถเพิ่ม Vendor ที่ได้รับการอนุมัติเข้าสู่ระบบ Living Mart ของโครงการได้ผ่าน PMS Dashboard' },
  { q: 'ลูกบ้านชำระเงินผ่านช่องทางไหน?', a: 'ชำระผ่าน QR PromptPay บัตรเครดิต/เดบิต หรือหักจาก Wallet ใน Urbanice App ได้ทันที ลูกบ้านได้รับใบเสร็จอิเล็กทรอนิกส์ทันที' },
  { q: 'มีระบบ Rating Vendor ไหม?', a: 'มี ลูกบ้านสามารถให้คะแนนและรีวิวบริการได้หลังงานเสร็จ นิติบุคคลใช้คะแนนนี้คัดเลือก Vendor คุณภาพสำหรับโครงการ' },
];
---

<BaseLayout
  title="Living Mart — Home Service สำหรับลูกบ้าน | The LivingOS"
  description="บริการครบวงจรในโครงการผ่านแอป Urbanice: ทำความสะอาด ซักรีด ดูแลต้นไม้ และบริการอื่นๆ"
>
  <InnerHero
    badge="HOME SERVICE"
    breadcrumb="SOLUTIONS · PROPERTY MANAGEMENT"
    headline="บริการ Home Service ครบครันสำหรับลูกบ้าน"
    accentWord="ครบครัน"
    subheadline="Living Mart เชื่อมลูกบ้านกับผู้ให้บริการในโครงการผ่านแอป Urbanice สั่งบริการได้ทันที ชำระออนไลน์ และติดตามสถานะได้จนงานเสร็จ"
    cta1={{ label: 'ขอ Demo ฟรี', href: '/request-demo' }}
    cta2={{ label: 'ดูข้อมูลเพิ่มเติม', href: '#features' }}
    accentHex={ACCENT}
    accentLightHex={ACCENT_LIGHT}
  >
    <div slot="visual" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;gap:20px;flex-wrap:wrap;padding:20px;">
      {['🧹 ทำความสะอาด','👕 ซักรีด','🌿 ดูแลต้นไม้','🔧 ซ่อมแซม','🚿 ล้างแอร์'].map((s) => (
        <div style={`background:#fff;border-radius:12px;padding:10px 18px;font-size:13px;font-weight:500;color:#3D3D3D;box-shadow:0 2px 8px rgba(19,168,174,.14);border-left:3px solid ${ACCENT};`}>{s}</div>
      ))}
    </div>
  </InnerHero>

  <SolutionOverview
    headline="ตลาด Home Service ในโครงการคุณ สั่งได้ทันทีผ่านแอป"
    subheadline="Living Mart เชื่อมลูกบ้านกับผู้ให้บริการที่น่าเชื่อถือในโครงการ ชำระออนไลน์ ติดตาม Status ได้จนงานเสร็จ"
    bgColor={ACCENT}
    cards={[
      {
        title: 'บริการครบในแอป Urbanice',
        description: 'ทำความสะอาด ซักรีด ดูแลต้นไม้ ซ่อมแซม และอื่นๆ สั่งได้ทันทีในแอปที่ลูกบ้านใช้อยู่แล้ว',
        emoji: '📱',
        badge: 'All-in-One',
        badgeHex: ACCENT,
      },
      {
        title: 'ชำระออนไลน์ ใบเสร็จทันที',
        description: 'QR PromptPay หรือบัตรเครดิต ชำระในแอปได้เลย ได้รับใบเสร็จอิเล็กทรอนิกส์ทันที',
        emoji: '💳',
        badge: 'Online Payment',
        badgeHex: ACCENT,
      },
      {
        title: 'Vendor คุณภาพที่นิติบุคคลคัดมา',
        description: 'นิติบุคคลควบคุม Whitelist Vendor ในโครงการ ลูกบ้านมั่นใจได้ว่าผู้ให้บริการผ่านการตรวจสอบ',
        emoji: '✅',
        badge: 'Verified Vendors',
        badgeHex: ACCENT,
      },
      {
        title: 'Rating & Review ทุกบริการ',
        description: 'ลูกบ้านให้คะแนนหลังงานเสร็จ ช่วยนิติบุคคลคัดเลือก Vendor คุณภาพสม่ำเสมอ',
        emoji: '⭐',
        badge: 'Rated Service',
        badgeHex: ACCENT,
      },
    ]}
  />

  <!-- Features -->
  <section id="features" class="section-pad" style="background:var(--color-warm-surface);">
    <div class="container-los">

      <div class="feat-row reveal-up">
        <div class="reveal-left">
          <div class="overline mb-3" style={`color:${ACCENT};`}>Marketplace</div>
          <h2 class="text-2xl font-bold text-text-1 mb-4">สั่งบริการได้ในไม่กี่ขั้นตอน</h2>
          <p class="text-md font-light text-text-3 mb-6">ลูกบ้านเลือกบริการ กำหนดวันเวลา และชำระเงินในแอป Urbanice ได้เลย โดยไม่ต้องโทรหาโอเปอเรเตอร์ ระบบยืนยันและแจ้งเตือนอัตโนมัติ</p>
          <ul class="feat-list">
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>เลือกบริการ กำหนดวันเวลา จ่ายในขั้นตอนเดียว</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>ติดตาม Status งานจนเสร็จสิ้น</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Rating & Review Vendor หลังงานเสร็จ</li>
          </ul>
        </div>
        <div class="feat-visual reveal-right" style={`background: linear-gradient(135deg, ${ACCENT_LIGHT} 0%, #fff 100%); border: 1.5px solid ${ACCENT}22;`}>
          <div style="position:absolute;inset:0;background-image:radial-gradient(circle,rgba(19,168,174,.12) 1px,transparent 1px);background-size:28px 28px;"></div>
          <div style="position:relative;z-index:1;text-align:center;">
            <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:10px;"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            <p style={`font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:${ACCENT};`}>MARKETPLACE</p>
          </div>
        </div>
      </div>

      <div class="feat-row feat-reverse" style="margin-top:96px;">
        <div class="reveal-right">
          <div class="overline mb-3" style={`color:${ACCENT};`}>Vendor Management</div>
          <h2 class="text-2xl font-bold text-text-1 mb-4">จัดการ Vendor คุณภาพของโครงการ</h2>
          <p class="text-md font-light text-text-3 mb-6">นิติบุคคลควบคุมรายชื่อ Vendor ที่อนุมัติให้บริการในโครงการ กำหนด Slot รับงานสูงสุด ดูประวัติงาน และใช้ Rating จากลูกบ้านในการคัดเลือก</p>
          <ul class="feat-list">
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>อนุมัติ / ระงับ Vendor ได้ทุกเวลา</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Commission Report สำหรับนิติบุคคล</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>เชื่อมต่อกับ PMS รายรับเข้าบัญชีอัตโนมัติ</li>
          </ul>
        </div>
        <div class="feat-visual reveal-left" style={`background: linear-gradient(135deg, ${ACCENT_LIGHT} 0%, #fff 100%); border: 1.5px solid ${ACCENT}22;`}>
          <div style="position:absolute;inset:0;background-image:radial-gradient(circle,rgba(19,168,174,.12) 1px,transparent 1px);background-size:28px 28px;"></div>
          <div style="position:relative;z-index:1;text-align:center;">
            <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:10px;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <p style={`font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:${ACCENT};`}>VENDORS</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <InnerFAQ items={faqs} accentHex={ACCENT} />
  <CTABanner />
</BaseLayout>

<script>
  import '../../scripts/gsap-init';
</script>

<style>
  .feat-reverse { direction: rtl; }
  .feat-reverse > * { direction: ltr; }
  @media (max-width: 768px) { .feat-reverse { direction: ltr; } }
</style>
