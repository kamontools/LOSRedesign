---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerHero from '../../components/shared/InnerHero.astro';
import InnerFAQ from '../../components/shared/InnerFAQ.astro';
import CTABanner from '../../components/home/CTABanner.astro';
import SolutionOverview from '../../components/shared/SolutionOverview.astro';

const ACCENT = '#91BBFF';
const ACCENT_LIGHT = '#EBF3FF';
const SOV_BG = '#1E40AF';

const reviews = [
  { name: 'คุณ สมศักดิ์ อ.', role: 'กรรมการนิติบุคคล · คอนโด The Grand', text: 'ประชุมใหญ่ที่เคยใช้เวลา 3 ชั่วโมงกับบัตรลงคะแนน ตอนนี้จบใน 1 ชั่วโมง ลูกบ้านไม่ต้องมาเองก็โหวตได้ ครบองค์ประชุมง่ายขึ้นมาก' },
  { name: 'คุณ วันดี ก.', role: 'ผู้จัดการนิติบุคคล · หมู่บ้าน The Valley', text: 'ผลโหวตออกมาทันทีหลังปิดลงคะแนน Audit Trail ชัดเจน ไม่มีข้อโต้แย้งเรื่องความโปร่งใสเหมือนแต่ก่อน ลูกบ้านเชื่อถือมากขึ้น' },
];

const faqs = [
  { q: 'i-Vote ใช้ได้กับการประชุมใหญ่แบบ Hybrid ไหม?', a: 'ได้ รองรับทั้งลูกบ้านที่มาร่วมในห้องและที่ Vote ออนไลน์ผ่าน Urbanice App พร้อมกัน ระบบรวมผลและแสดง Live บน Screen ห้องประชุม' },
  { q: 'รองรับการมอบฉันทะได้ไหม?', a: 'ได้ ลูกบ้านมอบฉันทะให้ผู้อื่นผ่านแอปได้ ระบบตรวจสอบสิทธิ์และนับคะแนนแทนผู้ถือหน่วยโดยอัตโนมัติ' },
  { q: 'ผลการลงคะแนนเก็บไว้ตรวจสอบได้นานแค่ไหน?', a: 'เก็บตลอดอายุสัญญาของโครงการ สามารถ Export รายงานฉบับสมบูรณ์พร้อม Audit Log ทุก Action ในรูป PDF สำหรับใช้อ้างอิงทางกฎหมาย' },
  { q: 'ต้องมีกี่สมาชิกออนไลน์ถึงจะใช้ได้?', a: 'ไม่มีขั้นต่ำ ระบบนับจำนวนผู้ที่ Login เข้าร่วมเป็น Quorum ตามหลักเกณฑ์ที่กำหนดไว้ใน พ.ร.บ. อาคารชุด' },
];
---

<BaseLayout
  title="i-Vote — ระบบลงคะแนนเสียง AGM ออนไลน์ | The LivingOS"
  description="ประชุมใหญ่นิติบุคคลออนไลน์: AGM Real-time Voting, Dashboard ผลคะแนน, รองรับ Hybrid และมอบฉันทะ"
>
  <InnerHero
    badge="SERVICES · i-VOTE"
    breadcrumb="SOLUTIONS · SERVICES"
    headline="ลงคะแนนเสียง AGM ออนไลน์ โปร่งใส ครบองค์"
    accentWord="โปร่งใส"
    subheadline="i-Vote ทำให้การประชุมใหญ่นิติบุคคล (AGM) เป็นเรื่องง่าย ลูกบ้านลงคะแนนจากที่ไหนก็ได้ ผลออกทันที โปร่งใสและตรวจสอบได้ทุกขั้นตอน"
    cta1={{ label: 'ขอใบเสนอราคา', href: '/request-demo' }}
    cta2={{ label: 'ดูฟีเจอร์ทั้งหมด', href: '#features' }}
    accentHex={ACCENT}
    accentLightHex={ACCENT_LIGHT}
  >
    <div slot="visual" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;gap:24px;">
      <div style={`background:#fff;border-radius:16px;padding:24px;box-shadow:0 8px 32px rgba(145,187,255,.18);min-width:240px;`}>
        <div style={`font-family:var(--font-mono);font-size:10px;font-weight:600;color:${ACCENT};margin-bottom:14px;letter-spacing:.1em;`}>LIVE VOTE — วาระที่ 3</div>
        {[['เห็นชอบ','78%',ACCENT],['ไม่เห็นชอบ','18%','#DC2626'],['งดออกเสียง','4%','#9A9A9A']].map(([l,v,c]) => (
          <div style="margin-bottom:10px;">
            <div style="display:flex;justify-content:space-between;margin-bottom:4px;font-size:12px;">
              <span style="color:#3D3D3D;font-weight:500;">{l}</span>
              <span style={`color:${c};font-weight:700;font-family:var(--font-mono);`}>{v}</span>
            </div>
            <div style="height:6px;background:#F5F3EE;border-radius:4px;overflow:hidden;">
              <div style={`height:100%;background:${c};border-radius:4px;width:${v};transition:width .5s;`}></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </InnerHero>

  <SolutionOverview
    headline="ประชุมใหญ่ออนไลน์ โปร่งใส ครบองค์ ผลออกทันที"
    subheadline="i-Vote ทำให้ AGM ง่ายและโปร่งใส ลูกบ้านลงคะแนนจากที่ไหนก็ได้ รองรับ Hybrid และมอบฉันทะออนไลน์"
    bgColor={SOV_BG}
    cards={[
      {
        title: 'ลงคะแนนจากที่ไหนก็ได้',
        description: 'ลูกบ้านลงคะแนนผ่าน Urbanice App ระหว่างประชุม ไม่ต้องมาห้องประชุม รองรับ Online และ Hybrid',
        emoji: '📱',
        badge: 'Online Voting',
        badgeHex: SOV_BG,
      },
      {
        title: 'ผลออกทันที โปร่งใส',
        description: 'Dashboard แสดงผลคะแนนแบบ Live บน Screen ห้องประชุม Audit Log ทุก Vote พร้อม Timestamp',
        emoji: '📊',
        badge: 'Real-time Result',
        badgeHex: SOV_BG,
      },
      {
        title: 'รองรับมอบฉันทะออนไลน์',
        description: 'ลูกบ้านมอบฉันทะให้ผู้อื่นผ่านแอป ระบบตรวจสอบสิทธิ์และนับคะแนนแทนอัตโนมัติ',
        emoji: '📋',
        badge: 'Proxy Support',
        badgeHex: SOV_BG,
      },
      {
        title: 'Quorum Tracking Real-time',
        description: 'ติดตามจำนวนผู้เข้าร่วมและ Quorum แบบ Real-time ตาม พ.ร.บ. อาคารชุด',
        emoji: '✅',
        badge: 'Auto Quorum',
        badgeHex: SOV_BG,
      },
    ]}
  />

  <!-- Features -->
  <section id="features" class="section-pad" style="background:var(--color-warm-surface);">
    <div class="container-los">

      <div class="feat-row reveal-up">
        <div class="reveal-left">
          <div class="overline mb-3" style={`color:${ACCENT};`}>AGM Real-time Voting</div>
          <h2 class="text-2xl font-bold text-text-1 mb-4">ลงคะแนนจากที่ไหนก็ได้แบบ Real-time</h2>
          <p class="text-md font-light text-text-3 mb-6">ลูกบ้านลงคะแนนผ่าน Urbanice App ในระหว่างประชุม ไม่ต้องมาห้องประชุม รองรับทั้งแบบ Online-only และ Hybrid ผู้ดำเนินการประชุมเปิด-ปิดแต่ละวาระได้แบบ Real-time</p>
          <ul class="feat-list">
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Vote ผ่านแอป ไม่ต้องใช้บัตรกระดาษ</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>รองรับมอบฉันทะออนไลน์</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Quorum Tracking แบบ Real-time</li>
          </ul>
        </div>
        <div class="feat-visual reveal-right" style={`background: linear-gradient(135deg, ${ACCENT_LIGHT} 0%, #fff 100%); border: 1.5px solid ${ACCENT}22;`}>
          <div style="position:absolute;inset:0;background-image:radial-gradient(circle,rgba(145,187,255,.12) 1px,transparent 1px);background-size:28px 28px;"></div>
          <div style="position:relative;z-index:1;text-align:center;">
            <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:10px;"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            <p style={`font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:${ACCENT};`}>LIVE VOTING</p>
          </div>
        </div>
      </div>

      <div class="feat-row feat-reverse" style="margin-top:96px;">
        <div class="reveal-right">
          <div class="overline mb-3" style={`color:${ACCENT};`}>Results Dashboard</div>
          <h2 class="text-2xl font-bold text-text-1 mb-4">ผลคะแนนออกทันที โปร่งใส ตรวจสอบได้</h2>
          <p class="text-md font-light text-text-3 mb-6">Dashboard แสดงผลคะแนนแบบ Live บน Screen ห้องประชุม เมื่อปิดวาระผลออกทันที พร้อม Audit Log ทุก Action เพื่อใช้อ้างอิงทางกฎหมาย Export รายงาน PDF ได้ทันที</p>
          <ul class="feat-list">
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Bar Chart แสดงผลแบบ Realtime บน Projector</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Audit Log ทุก Vote พร้อม Timestamp</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Export รายงานสมบูรณ์ PDF สำหรับเก็บบันทึก</li>
          </ul>
        </div>
        <div class="feat-visual reveal-left" style={`background: linear-gradient(135deg, ${ACCENT_LIGHT} 0%, #fff 100%); border: 1.5px solid ${ACCENT}22;`}>
          <div style="position:absolute;inset:0;background-image:radial-gradient(circle,rgba(145,187,255,.12) 1px,transparent 1px);background-size:28px 28px;"></div>
          <div style="position:relative;z-index:1;text-align:center;">
            <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:10px;"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            <p style={`font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:${ACCENT};`}>RESULTS</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Customer Reviews -->
  <section class="section-pad" style="background:var(--color-warm-page);">
    <div class="container-los">
      <div class="text-center mb-12 reveal-up">
        <div class="overline mb-3" style={`color:${ACCENT};`}>Customer Review</div>
        <h2 class="text-3xl font-bold text-text-1">ผู้ใช้จริงพูดว่าอย่างไร</h2>
      </div>
      <div class="reviews-grid reveal-stagger">
        {reviews.map((r) => (
          <div class="review-card">
            <p class="review-text">"{r.text}"</p>
            <div class="review-author">
              <div class="review-avatar" style={`background:${ACCENT}18;color:${ACCENT};`}>{r.name.charAt(2)}</div>
              <div>
                <div class="review-name">{r.name}</div>
                <div class="review-role">{r.role}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Request a Quote -->
  <section class="section-pad" style="background:var(--color-warm-surface);">
    <div class="container-los max-w-2xl mx-auto text-center reveal-up">
      <div class="overline mb-3" style={`color:${ACCENT};`}>Request a Quote</div>
      <h2 class="text-3xl font-bold text-text-1 mb-4">ขอใบเสนอราคา i-Vote</h2>
      <p class="text-md text-text-3 font-light mb-8">ราคาขึ้นอยู่กับจำนวนยูนิตและความถี่การใช้งาน ทีมงานจะประเมินและส่งใบเสนอราคาภายใน 1 วันทำการ</p>
      <a href="/request-demo" class="ih-cta-primary" style={`background:${ACCENT};box-shadow:0 4px 18px rgba(145,187,255,.38);display:inline-flex;align-items:center;gap:8px;padding:14px 32px;border-radius:12px;color:#fff;font-size:15px;font-weight:600;text-decoration:none;`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        ขอใบเสนอราคาฟรี
      </a>
    </div>
  </section>

  <InnerFAQ items={faqs} accentHex={ACCENT} />
  <CTABanner />
</BaseLayout>

<script>
  import '../../scripts/gsap-init';
</script>

<style>
  .feat-reverse { direction: rtl; }
  .feat-reverse > * { direction: ltr; }
  @media (max-width: 768px) { .feat-reverse { direction: ltr; } }

  .reviews-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .review-card {
    background: #fff;
    border: 1.5px solid var(--color-warm-border-light);
    border-radius: 16px;
    padding: 28px;
    box-shadow: var(--shadow-sm);
  }
  .review-text {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-2);
    margin-bottom: 20px;
  }
  .review-author { display: flex; align-items: center; gap: 12px; }
  .review-avatar {
    width: 40px; height: 40px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 16px; flex-shrink: 0;
  }
  .review-name { font-size: 14px; font-weight: 600; color: var(--color-text-1); }
  .review-role { font-size: 12px; color: var(--color-text-4); }

  @media (max-width: 640px) { .reviews-grid { grid-template-columns: 1fr; } }
</style>
