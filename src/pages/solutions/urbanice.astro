---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerHero from '../../components/shared/InnerHero.astro';
import SolutionOverview from '../../components/shared/SolutionOverview.astro';
import InnerFAQ from '../../components/shared/InnerFAQ.astro';
import CTABanner from '../../components/home/CTABanner.astro';

const ACCENT = '#13A8AE';
const ACCENT_LIGHT = '#E0F7F8';

const features = [
  {
    id: 'parcel',
    label: 'Parcel Management',
    headline: 'รับพัสดุ แจ้งเตือนลูกบ้านอัตโนมัติ',
    desc: 'ระบบบันทึกพัสดุด้วย QR Code และรูปถ่าย แจ้งเตือน Push Notification ถึงลูกบ้านทันที ลดภาระ รปภ. และลดพัสดุสูญหาย',
    points: ['บันทึกด้วย QR Code หรือบาร์โค้ด', 'แจ้งเตือนอัตโนมัติผ่านแอป + Line', 'ประวัติรับ-คืนพัสดุครบถ้วน'],
    icon: `<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>`,
  },
  {
    id: 'booking',
    label: 'Facility Booking',
    headline: 'จองสิ่งอำนวยความสะดวกออนไลน์',
    desc: 'ลูกบ้านจองสระว่ายน้ำ ฟิตเนส ห้องประชุม และสถานที่ส่วนกลางได้เองผ่านแอป ระบุวันเวลา ชำระค่ามัดจำออนไลน์ และรับการยืนยันทันที',
    points: ['ปฏิทินเรียลไทม์ ดูว่างได้ทันที', 'ชำระค่ามัดจำออนไลน์', 'แจ้งเตือนก่อนเวลาจอง 1 ชั่วโมง'],
    icon: `<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>`,
  },
  {
    id: 'announce',
    label: 'Announcements',
    headline: 'ประกาศและข่าวสารจากนิติบุคคล',
    desc: 'นิติบุคคลส่งประกาศถึงลูกบ้านทุกคนหรือเฉพาะอาคาร/ชั้น พร้อมแนบรูปหรือเอกสาร PDF ลูกบ้านรับได้ทั้ง Push Notification และในฟีด',
    points: ['ส่งถึงทุกคนหรือกลุ่มเป้าหมาย', 'แนบรูปและเอกสาร PDF', 'ติดตามสถิติการอ่าน'],
    icon: `<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>`,
  },
  {
    id: 'repair',
    label: 'Repair Request',
    headline: 'แจ้งซ่อมพร้อมรูป ติดตามสถานะได้',
    desc: 'ลูกบ้านแจ้งซ่อมพร้อมรูปภาพและตำแหน่งจุดเสีย ระบบส่งต่อให้ช่างอัตโนมัติ และลูกบ้านสามารถติดตาม status ได้ตลอดเวลา',
    points: ['แนบรูปภาพและวิดีโอได้', 'ระบุตำแหน่งจุดเสียบนแผนผัง', 'Track status — รับเรื่อง / ดำเนินการ / เสร็จสิ้น'],
    icon: `<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>`,
  },
  {
    id: 'payment',
    label: 'Payment Reminder',
    headline: 'แจ้งเตือนและรับชำระค่าส่วนกลางในแอป',
    desc: 'ลูกบ้านรับใบแจ้งหนี้ค่าส่วนกลางผ่านแอป ชำระออนไลน์ด้วย QR PromptPay หรือบัตรเครดิต และดาวน์โหลดใบเสร็จได้ทันที',
    points: ['ชำระผ่าน QR PromptPay / บัตรเครดิต', 'ดาวน์โหลดใบเสร็จอิเล็กทรอนิกส์', 'ประวัติชำระย้อนหลังครบถ้วน'],
    icon: `<rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>`,
  },
  {
    id: 'estamp',
    label: 'Visitor E-Stamp',
    headline: 'ออก E-Stamp ผู้เยี่ยมชมในไม่กี่วินาที',
    desc: 'ลูกบ้านออก QR Code ให้ผู้เยี่ยมชมผ่านแอป รปภ. สแกนตรงประตู เพิ่มความปลอดภัยโดยไม่ต้องโทรยืนยันทุกครั้ง ทำงานร่วมกับ GuardOS i-Pass',
    points: ['ออก QR ได้ทันทีผ่านแอป', 'กำหนดวันเวลาหมดอายุได้', 'Log การเข้าออกครบถ้วน'],
    icon: `<path d="M3 3h7v7H3z"/><path d="M14 3h7v7h-7z"/><path d="M3 14h7v7H3z"/><rect x="16" y="16" width="4" height="4"/>`,
  },
  {
    id: 'car',
    label: 'Car Directory',
    headline: 'ทะเบียนรถของโครงการค้นหาได้ทันที',
    desc: 'เก็บข้อมูลทะเบียนรถของลูกบ้านทุกคัน ช่วย รปภ. และ Parking System ตรวจสอบได้รวดเร็ว ลดเวลาคิวที่ประตู',
    points: ['เก็บทะเบียนรถพร้อมรูปภาพ', 'เชื่อมกับระบบ Parking อัตโนมัติ', 'รปภ. ค้นหาทะเบียนได้ทันที'],
    icon: `<rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-4"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>`,
  },
];

const faqs = [
  { q: 'รองรับ iOS และ Android ไหม?', a: 'รองรับทั้ง iOS 14+ และ Android 8+ สามารถดาวน์โหลดได้ที่ App Store และ Google Play Store ฟรี' },
  { q: 'ลูกบ้านต้องสมัครสมาชิกเองไหม?', a: 'นิติบุคคลเชิญลูกบ้านผ่าน SMS หรืออีเมลได้ ลูกบ้านลงทะเบียนครั้งเดียวและยืนยันตัวตนผ่านหมายเลขห้อง ไม่ต้องใช้เอกสารเพิ่มเติม' },
  { q: 'แอปใช้งานออฟไลน์ได้ไหมถ้าอินเทอร์เน็ตหลุด?', a: 'ฟีเจอร์หลักบางอย่าง เช่น ดูใบแจ้งหนี้ที่โหลดไว้แล้วและประวัติพัสดุ ใช้งานแบบ Offline ได้ ส่วนฟีเจอร์ที่ต้องการข้อมูลสด เช่น Booking จะต้องเชื่อมต่อ' },
  { q: 'ข้อมูลส่วนตัวลูกบ้านปลอดภัยไหม?', a: 'ข้อมูลถูกเข้ารหัสด้วย AES-256 และจัดเก็บบนเซิร์ฟเวอร์ในประเทศไทย เป็นไปตาม PDPA ลูกบ้านสามารถขอดู แก้ไข หรือลบข้อมูลส่วนตัวได้ตลอดเวลา' },
  { q: 'Living Mart Home Service ต่างจากการแจ้งซ่อมปกติอย่างไร?', a: 'การแจ้งซ่อมปกติใช้สำหรับงานซ่อมบำรุงส่วนกลางที่นิติบุคคลดูแล ส่วน Living Mart Home Service คือบริการที่ลูกบ้านสั่งและชำระเองสำหรับห้องส่วนตัว เช่น ทำความสะอาด ซักรีด ล้างแอร์' },
  { q: 'Living Mart มีสินค้าและดีลประเภทไหนบ้าง?', a: 'มีทั้งของใช้ในบ้าน เครื่องใช้ไฟฟ้า สินค้าไลฟ์สไตล์ และดีลพิเศษจาก Partner ที่คัดสรรมาสำหรับลูกบ้านในโครงการ พร้อมส่งตรงถึงห้องโดยไม่ต้องออกจากคอนโด' },
  { q: 'นิติบุคคลสามารถเพิ่ม Vendor หรือ Partner ของตัวเองได้ไหม?', a: 'ได้ นิติบุคคลสามารถเพิ่ม Vendor ที่ได้รับการอนุมัติเข้าสู่ระบบ Living Mart ของโครงการได้ผ่าน PMS Dashboard และกำหนด Commission Report ได้ด้วย' },
];
---

<BaseLayout
  title="Urbanice App — แอปลูกบ้านครบวงจร | The LivingOS"
  description="แอปสำหรับลูกบ้าน: รับพัสดุ จองสิ่งอำนวยความสะดวก แจ้งซ่อม ชำระค่าส่วนกลาง และอีกมากมาย"
>
  <InnerHero
    badge="RESIDENT APP"
    breadcrumb="SOLUTIONS · PROPERTY MANAGEMENT"
    headline="แอปลูกบ้านที่ใช้งานง่าย ครบทุกความต้องการ"
    accentWord="ใช้งานง่าย"
    subheadline="Urbanice App เชื่อมนิติบุคคลกับลูกบ้านในแอปเดียว ตั้งแต่รับพัสดุ จองสิ่งอำนวยความสะดวก ไปจนถึงชำระค่าส่วนกลาง — ไม่ต้องโทรหาออฟฟิศอีกต่อไป"
    cta1={{ label: 'ขอ Demo ฟรี', href: '/request-demo' }}
    cta2={{ label: 'ดูฟีเจอร์ทั้งหมด', href: '#features' }}
    accentHex={ACCENT}
    accentLightHex={ACCENT_LIGHT}
  >
    <div slot="visual" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;gap:32px;">
      <div style={`background:#fff;border-radius:20px;padding:20px 24px;box-shadow:0 8px 32px rgba(19,168,174,.18);text-align:center;`}>
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:8px"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <div style={`font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:.08em;color:${ACCENT};`}>URBANICE</div>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px;">
        {['รับพัสดุ', 'จอง Facility', 'แจ้งซ่อม', 'ชำระค่าส่วนกลาง'].map((t) => (
          <div style={`background:#fff;border-radius:10px;padding:8px 16px;font-size:12px;font-weight:500;color:#3D3D3D;box-shadow:0 2px 8px rgba(19,168,174,.12);border-left:3px solid ${ACCENT};`}>{t}</div>
        ))}
      </div>
    </div>
  </InnerHero>

  <!-- Solution overview: what is Urbanice + 4 key benefits -->
  <SolutionOverview
    headline="ชีวิตในคอนโดง่ายขึ้น เพราะแอปเดียวจัดการได้ทุกอย่าง"
    subheadline="Urbanice App เชื่อมลูกบ้านกับนิติบุคคลให้ใกล้ชิดกว่าเดิม ไม่ว่าจะรับพัสดุ จองสิ่งอำนวยความสะดวก หรือชำระค่าส่วนกลาง"
    bgColor={ACCENT}
    cards={[
      {
        title: 'รวมทุกความต้องการในแอปเดียว',
        description: 'พัสดุ จอง Facility แจ้งซ่อม ชำระค่าส่วนกลาง ดูประกาศ — ทำได้หมดโดยไม่ต้องโทรหาออฟฟิศ',
        emoji: '📱',
        badge: '7+ ฟีเจอร์',
        badgeHex: ACCENT,
      },
      {
        title: 'แจ้งเตือนทันที ไม่พลาดทุกสิ่งสำคัญ',
        description: 'Push Notification และ Line OA แจ้งลูกบ้านเมื่อพัสดุมาถึง ค่าส่วนกลางถึงกำหนด หรือมีประกาศใหม่',
        emoji: '🔔',
        badge: 'Real-time',
        badgeHex: ACCENT,
      },
      {
        title: 'ปลอดภัย เป็นไปตามมาตรฐาน PDPA',
        description: 'ข้อมูลลูกบ้านทุกชิ้นถูกเข้ารหัส AES-256 จัดเก็บบนเซิร์ฟเวอร์ในประเทศไทย ลูกบ้านควบคุมข้อมูลตัวเองได้เต็มที่',
        emoji: '🔐',
        badge: 'PDPA Compliant',
        badgeHex: ACCENT,
      },
      {
        title: 'ใช้งานง่าย ไม่ต้องมีความรู้ด้านเทคโนโลยี',
        description: 'UI ออกแบบสำหรับลูกบ้านทุกวัย ทีม LivingOS ดูแล Onboarding ให้ครบถ้วน พร้อมใช้งานได้ภายใน 1 วัน',
        emoji: '✨',
        badge: 'Setup ใน 1 วัน',
        badgeHex: ACCENT,
      },
    ]}
  />

  <!-- Stats -->
  <section class="section-pad" style="padding-top:40px;padding-bottom:64px;background:var(--color-warm-page);">
    <div class="container-los">
      <div class="stats-row reveal-up">
        <div class="stat-cell">
          <div class="stat-num" style={`color:${ACCENT};`}>500+</div>
          <div class="stat-lbl">โครงการที่ใช้งาน</div>
        </div>
        <div class="stat-cell">
          <div class="stat-num" style={`color:${ACCENT};`}>200K+</div>
          <div class="stat-lbl">ลูกบ้านที่ใช้แอป</div>
        </div>
        <div class="stat-cell">
          <div class="stat-num" style={`color:${ACCENT};`}>4.8</div>
          <div class="stat-lbl">คะแนนใน App Store</div>
        </div>
        <div class="stat-cell">
          <div class="stat-num" style={`color:${ACCENT};`}>99.9%</div>
          <div class="stat-lbl">Uptime SLA</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="section-pad" style="background:var(--color-warm-surface);">
    <div class="container-los">
      <div class="text-center mb-16 reveal-up">
        <div class="overline mb-3" style={`color:${ACCENT};`}>ฟีเจอร์ทั้งหมด</div>
        <h2 class="text-3xl lg:text-4xl font-bold text-text-1">ครบทุกความต้องการในแอปเดียว</h2>
      </div>

      {features.map((f, i) => (
        <div class={`feat-row ${i % 2 !== 0 ? 'feat-reverse' : ''}`} style={i > 0 ? 'margin-top:96px;' : ''}>
          <div class={i % 2 !== 0 ? 'reveal-right' : 'reveal-left'}>
            <div class="overline mb-3" style={`color:${ACCENT};`}>{f.label}</div>
            <h3 class="text-2xl font-bold text-text-1 mb-4">{f.headline}</h3>
            <p class="text-md font-light text-text-3 mb-6">{f.desc}</p>
            <ul class="feat-list">
              {f.points.map((p) => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  {p}
                </li>
              ))}
            </ul>
          </div>
          <div
            class={`feat-visual ${i % 2 !== 0 ? 'reveal-left' : 'reveal-right'}`}
            style={`background: linear-gradient(135deg, ${ACCENT_LIGHT} 0%, #fff 100%); border: 1.5px solid ${ACCENT}22;`}
          >
            <div style="position:absolute;inset:0;background-image:radial-gradient(circle,rgba(19,168,174,.12) 1px,transparent 1px);background-size:28px 28px;"></div>
            <div style="position:relative;z-index:1;text-align:center;">
              <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke={ACCENT} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:10px;" set:html={f.icon}></svg>
              <p style={`font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:${ACCENT};`}>{f.label}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Home Service + Living Mart — 2 Cards -->
  <section class="section-pad" style="background:#fff;">
    <div class="container-los">
      <div class="text-center mb-10 reveal-up">
        <h2 class="text-3xl lg:text-4xl font-bold text-text-1">และดีลสุดพิเศษ!</h2>
      </div>

      <div class="two-cards-grid">

        <!-- Card 1: Home Service -->
        <div class="service-card reveal-up">
          <div style="background:#fff;padding:28px 28px 22px;flex-shrink:0;">
            <div style="display:flex;align-items:center;gap:12px;margin-bottom:10px;">
              <h2 style="font-size:34px;font-weight:700;line-height:1.15;color:#1A1A1A;margin:0;flex:1;">Home Service</h2>
              <div style="width:22px;height:22px;border-radius:50%;flex-shrink:0;background:radial-gradient(circle at 38% 35%,#FF6B6B,#C0000C);box-shadow:inset 2px 2px 3px rgba(255,180,180,.65),inset -1.5px -1.5px 3px rgba(80,0,0,.45),0 3px 8px rgba(180,0,20,.35);"></div>
            </div>
            <p style="font-size:14px;color:#6B6B6B;line-height:1.65;">สั่งทำความสะอาด ซักรีด ล้างแอร์ และอีกมากมาย ได้ทันทีในแอป Vendor ผ่านการคัดสรรจากนิติบุคคล</p>
          </div>
          <div style={`flex:1;position:relative;background:linear-gradient(180deg,#B2E8EA 0%,#7ACFD3 100%);display:flex;align-items:center;justify-content:center;padding:28px;min-height:280px;`}>
            <div style="display:flex;flex-direction:column;gap:10px;width:100%;max-width:280px;">
              {[
                { emoji: '🧹', name: 'ทำความสะอาด', tag: 'ใน 2 ชม.' },
                { emoji: '👕', name: 'ซักรีด', tag: 'ส่งคืนวันถัดไป' },
                { emoji: '🚿', name: 'ล้างแอร์', tag: 'นัดได้ทันที' },
                { emoji: '🌿', name: 'ดูแลต้นไม้', tag: 'รายเดือน' },
              ].map((s) => (
                <div style="display:flex;align-items:center;gap:12px;background:rgba(255,255,255,.88);border-radius:12px;padding:10px 16px;box-shadow:var(--shadow-sm);">
                  <span style="font-size:18px;">{s.emoji}</span>
                  <span style="font-size:13px;font-weight:600;color:#1A1A1A;flex:1;">{s.name}</span>
                  <span style={`font-family:var(--font-mono);font-size:11px;font-weight:700;color:${ACCENT};`}>{s.tag}</span>
                </div>
