<script>
  (function () {
    const navItems = Array.from(document.querySelectorAll<HTMLElement>('#whyNav .why-nav-item'));
    const anchors  = Array.from(document.querySelectorAll<HTMLElement>('[data-panel-anchor]'));

    function setActive(index: number) {
      navItems.forEach((n, i) => n.classList.toggle('is-active', i === index));
    }

    // Scroll-based: update nav when panel enters viewport
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const idx = Number((entry.target as HTMLElement).dataset.panelAnchor);
            setActive(idx);
          }
        });
      },
      { threshold: 0.4 }
    );

    anchors.forEach((a) => observer.observe(a));

    // Click nav: smooth scroll to that panel
    navItems.forEach((item, i) => {
      item.addEventListener('click', () => {
        anchors[i]?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });
  })();
</script>
