---
---

<section class="hero-section">
  <div class="hero-stage">

  <!-- ── Video — full width, top of hero ── -->
  <div class="hero-video-outer">
    <div class="hero-mockup hero-video-inner">
      <iframe
        src="https://www.youtube.com/embed/ibMLcCWiobY?autoplay=1&mute=1&loop=1&playlist=ibMLcCWiobY&controls=0&showinfo=0&rel=0&modestbranding=1&iv_load_policy=3&disablekb=1&fs=0&playsinline=1"
        frameborder="0"
        allow="autoplay; encrypted-media"
        style="position:absolute;inset:0;width:100%;height:100%;border:none;"
        title="LivingOS Demo"
      ></iframe>
    </div>
  </div>

  <!-- ── Content card — slides up over video bottom ── -->
  <div class="hero-copy-card">

    <!-- Gold eyebrow -->
    <div class="hero-eyebrow eyebrow-gold inline-flex items-center gap-2 mb-5">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;opacity:.85;">
        <path d="M6 9H4a2 2 0 0 1-2-2V5h4" stroke="#7A4F00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M18 9h2a2 2 0 0 0 2-2V5h-4" stroke="#7A4F00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M6 2h12v7a6 6 0 0 1-12 0V2Z" fill="rgba(122,79,0,.12)" stroke="#7A4F00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M12 15v4" stroke="#7A4F00" stroke-width="2" stroke-linecap="round"/>
        <path d="M8 22h8" stroke="#7A4F00" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <span class="eyebrow-gold-text">
        <span class="eyebrow-text-full">Property Management System · No.1 in Thailand</span>
        <span class="eyebrow-text-short">PMS No.1 IN THAILAND</span>
      </span>
      <span class="eyebrow-shimmer" aria-hidden="true"></span>
    </div>

    <!-- Headline -->
    <h1 class="hero-word hero-headline">
      บริหารนิติบุคคล<em style="font-style:normal;color:var(--color-primary);">ได้ฉลาดกว่าเดิม</em>
    </h1>

    <!-- CTA buttons + trust pills in one row -->
    <div class="hero-cta hero-actions">
      <a href="#" class="cta-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3l14 9-14 9V3z"/></svg>
        เริ่มใช้งานฟรี 30 วัน
      </a>
      <a href="#" class="cta-secondary">
        ดูวิดีโอการทำงาน
      </a>
      <span class="actions-divider" aria-hidden="true"></span>
<span class="trust-pill">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        ติดตั้งได้ภายใน 1 วัน
      </span>
      <span class="trust-pill">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        รองรับโครงการทุกขนาด
      </span>
    </div>

  </div>

  </div><!-- /.hero-stage -->
</section>

<style>
  /* ── Section shell ── */
  .hero-section {
    background: var(--color-warm-page);
    padding-top: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
  }

  /* ── Shared stage: constrains both video and card to same width ── */
  .hero-stage {
    width: 100%;
    max-width: 1210px;
  }

  /* ── Video outer: full-width gutter wrapper ── */
  .hero-video-outer {
    width: 100%;
    padding: 8px 24px 0;
  }

  /* ── Video inner: aspect-ratio box with rounded corners ── */
  .hero-video-inner {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: var(--shadow-lg), 0 0 0 1px rgba(28,112,247,.06);
  }

  /* ── Copy card — overlaps up over video bottom ── */
  .hero-copy-card {
    display: flex;
    flex-direction: column;
    width: fit-content;
    padding: 40px 48px 48px;
    margin-top: -208px;
    margin-left: 64px;
    position: relative;
    z-index: 10;
    background: var(--color-warm-page);
    border-radius: 24px;
    text-align: left;
    border: 1.5px solid var(--color-warm-border-light);
    box-shadow: 0 -8px 32px rgba(60,45,20,.08), 0 -2px 8px rgba(60,45,20,.05), var(--shadow-sm);
  }

  /* ── Headline ── */
  .hero-headline {
    font-size: clamp(28px, 3.8vw, 48px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--color-text-1);
    margin-bottom: 20px;
  }

  /* ── CTA row ── */
  .hero-cta,
  .hero-actions {
    width: fit-content;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    flex-wrap: wrap;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: 12px;
    background: var(--color-primary);
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 4px 18px rgba(28,112,247,.35);
    transition: transform .15s, box-shadow .15s;
  }
  .cta-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 24px rgba(28,112,247,.45);
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: 12px;
    background: var(--color-warm-surface);
    color: var(--color-text-1);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    border: 1.5px solid var(--color-warm-border-light);
    transition: background .15s, border-color .15s;
  }
  .cta-secondary:hover {
    background: var(--color-warm-overlay);
    border-color: var(--color-warm-border-mid);
  }

  .actions-divider {
    width: 1px;
    height: 22px;
    background: var(--color-warm-border-mid);
    flex-shrink: 0;
    margin: 0 4px;
  }

  .trust-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--color-text-3);
  }

  /* ── Gold plate eyebrow ── */
  .hero-eyebrow {
    width: fit-content;
    align-self: flex-start;
  }

  .eyebrow-gold {
    position: relative;
    overflow: hidden;
    height: 32px;
    padding: 0 18px;
    border-radius: 9999px;
    border: 1.5px solid rgba(180, 130, 0, 0.45);
    background: linear-gradient(
      135deg,
      #F5E27A 0%,
      #E8C840 18%,
      #F0D060 35%,
      #C9A000 55%,
      #E8C840 72%,
      #F5E27A 88%,
      #D4A820 100%
    );
    box-shadow:
      0 1px 0 rgba(255,255,255,.55) inset,
      0 -1px 0 rgba(100,65,0,.18) inset,
      0 4px 16px rgba(180,130,0,.28),
      0 1px 4px rgba(180,130,0,.20);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .10em;
    text-transform: uppercase;
    cursor: default;
    user-select: none;
  }

  .eyebrow-gold-text {
    color: #4A2E00;
    position: relative;
    z-index: 1;
    text-shadow: 0 1px 0 rgba(255,230,100,.6);
  }

  .eyebrow-shimmer {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 30%,
      rgba(255,255,255,.55) 50%,
      transparent 70%
    );
    background-size: 220% 100%;
    background-position: -100% 0;
    animation: gold-shimmer 3.5s ease-in-out infinite;
    border-radius: 9999px;
  }

  @keyframes gold-shimmer {
    0%   { background-position: -120% 0; }
    40%  { background-position: 220% 0; }
    100% { background-position: 220% 0; }
  }

  .eyebrow-text-short { display: none; }

  /* ── Tablet (476–1279px) — intermediate overlap ── */
  @media (max-width: 1279px) {
    .hero-copy-card {
      width: fit-content;
      padding: 32px 32px 40px;
      margin-top: clamp(-140px, -13.5vw, -105px);
      margin-left: 72px;
      margin-right: 24px;
      border-radius: 24px;
    }
    .trust-pill,
    .actions-divider {
      display: none;
    }
  }

  /* ── Mobile (≤475px) ── */
  @media (max-width: 475px) {
    .eyebrow-text-full  { display: none; }
    .eyebrow-text-short { display: inline; }

    .hero-video-outer {
      padding: 12px 12px 0;
    }
    .hero-copy-card {
      padding: 24px 20px 32px;
      margin-top: 28px;
      margin-left: auto;
      margin-right: auto;
      border-radius: 20px;
    }
    .hero-headline {
      margin-bottom: 16px;
    }
    .actions-divider {
      display: none;
    }
  }
</style>
