---
const certs = [
  {
    id: 'cloud',
    label: 'Cloud Certified',
    labelTH: 'ผ่านการรับรองระบบคลาวด์',
    description: 'โครงสร้างพื้นฐานบนระบบคลาวด์ที่ผ่านการรับรองมาตรฐานสากล รองรับ uptime สูงและ auto-scaling',
    icon: `<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/>
    </svg>`,
    accent: '#1C70F7',
    bg: 'rgba(28,112,247,0.06)',
    border: 'rgba(28,112,247,0.18)',
  },
  {
    id: 'pdpa',
    label: 'PDPA Compliant',
    labelTH: 'สอดคล้องกับ พ.ร.บ. คุ้มครองข้อมูลส่วนบุคคล',
    description: 'ระบบออกแบบให้สอดคล้องกับ พ.ร.บ. คุ้มครองข้อมูลส่วนบุคคล พ.ศ. 2562 ครบทุกข้อกำหนด',
    icon: `<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      <polyline points="9 12 11 14 15 10"/>
    </svg>`,
    accent: '#16A34A',
    bg: 'rgba(22,163,74,0.06)',
    border: 'rgba(22,163,74,0.18)',
  },
];
---

<section class="section-pad" style="background: var(--color-warm-surface);">
  <div class="container-los">

    <!-- Header -->
    <div class="text-center mb-14 reveal-up">
      <div class="overline mb-3">Licensing & Compliance</div>
      <h2 class="text-3xl lg:text-4xl font-bold text-text-1 mb-4">
        มาตรฐานที่คุณวางใจได้
      </h2>
      <p class="text-md text-text-3 font-light max-w-md mx-auto leading-relaxed">
        LivingOS ผ่านการรับรองมาตรฐานด้านเทคโนโลยีและการคุ้มครองข้อมูล<br class="hidden md:block" />เพื่อให้ทุกโครงการดำเนินงานได้อย่างมั่นใจ
      </p>
    </div>

    <!-- Cert logo wall -->
    <div class="flex flex-col sm:flex-row items-stretch justify-center gap-5 max-w-2xl mx-auto reveal-stagger">
      {certs.map((cert) => (
        <div
          class="flex flex-1 flex-col items-center text-center gap-4 px-8 py-8 rounded-2xl border"
          style={`background: ${cert.bg}; border-color: ${cert.border};`}
        >
          <!-- Icon badge -->
          <div
            class="flex items-center justify-center w-16 h-16 rounded-2xl"
            style={`background: white; border: 1.5px solid ${cert.border}; color: ${cert.accent}; box-shadow: 0 2px 8px ${cert.bg};`}
            set:html={cert.icon}
          />

          <!-- Labels -->
          <div>
            <div class="font-bold text-lg text-text-1 leading-tight">{cert.label}</div>
            <div class="text-xs font-mono text-text-4 mt-1 leading-snug">{cert.labelTH}</div>
          </div>

          <!-- Description -->
          <p class="text-sm text-text-3 leading-relaxed">{cert.description}</p>

          <!-- Verified pill -->
          <div
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold"
            style={`background: white; border: 1px solid ${cert.border}; color: ${cert.accent};`}
          >
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            Verified
          </div>
        </div>
      ))}
    </div>

    <!-- Trust footnote -->
    <p class="text-center text-xs text-text-4 font-mono mt-8 reveal-up">
      ข้อมูลทั้งหมดเข้ารหัสด้วย TLS 1.3 · Hosted on certified cloud infrastructure · Regular security audits
    </p>

  </div>
</section>
