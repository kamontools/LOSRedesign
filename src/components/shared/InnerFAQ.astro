---
interface FAQItem {
  q: string;
  a: string;
}

interface Props {
  items: FAQItem[];
  overline?: string;
  title?: string;
  subtitle?: string;
  accentHex?: string;
}

const {
  items,
  overline = 'FAQ',
  title = 'คำถามที่พบบ่อย',
  subtitle,
  accentHex = '#1C70F7',
} = Astro.props;

const faqId = `faq-${Math.random().toString(36).slice(2, 9)}`;
---

<section class="section-pad" style="background: var(--color-warm-page);">
  <div class="container-los">
    <div class="text-center mb-14 reveal-up">
      <div class="overline mb-3" style={`color:${accentHex};`}>{overline}</div>
      <h2 class="text-3xl lg:text-4xl font-bold text-text-1 mb-4">{title}</h2>
      {subtitle
        ? <p class="text-md text-text-3 font-light max-w-lg mx-auto">{subtitle}</p>
        : <p class="text-md text-text-3 font-light max-w-lg mx-auto">
            ไม่พบคำตอบ? <a href="/company/contact" class="underline underline-offset-2" style={`color:${accentHex};`}>ติดต่อทีมงาน</a> — ตอบกลับภายใน 1 ชั่วโมงทำการ
          </p>
      }
    </div>

    <div class="max-w-3xl mx-auto flex flex-col gap-2 reveal-stagger" id={faqId}>
      {items.map((item) => (
        <div class="faq-item border border-warm-border-light rounded-xl bg-white overflow-hidden">
          <button
            class="faq-trigger w-full flex items-start justify-between gap-4 p-5 text-left hover:bg-warm-surface transition-colors"
            aria-expanded="false"
          >
            <span class="font-medium text-text-1 text-sm leading-relaxed">{item.q}</span>
            <svg
              class="faq-icon w-5 h-5 text-text-4 shrink-0 mt-0.5 transition-transform duration-300"
              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round"
            >
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="faq-answer" style="height: 0; overflow: hidden;">
            <div class="px-5 pb-5">
              <p class="text-sm text-text-2 leading-relaxed">{item.a}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script define:vars={{ faqId }}>
  const container = document.getElementById(faqId);
  if (!container) return;
  const triggers = container.querySelectorAll('.faq-trigger');

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.faq-item');
      const answer = item.querySelector('.faq-answer');
      const icon = trigger.querySelector('.faq-icon');
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      triggers.forEach((t) => {
        if (t !== trigger) {
          const a = t.closest('.faq-item').querySelector('.faq-answer');
          const ic = t.querySelector('.faq-icon');
          t.setAttribute('aria-expanded', 'false');
          a.style.height = '0';
          ic.style.transform = 'rotate(0deg)';
        }
      });

      if (isOpen) {
        trigger.setAttribute('aria-expanded', 'false');
        answer.style.height = '0';
        icon.style.transform = 'rotate(0deg)';
      } else {
        trigger.setAttribute('aria-expanded', 'true');
        answer.style.height = answer.scrollHeight + 'px';
        icon.style.transform = 'rotate(180deg)';
      }
    });
  });
</script>
